---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  title: string;
  description?: string;
  href: string;
}

const { icon, title, description, href } = Astro.props;
---

<a class="themen-kachel" href={href}>
  <span class="themen-kachel__icon">
    <Icon name={icon} size={28} />
  </span>
  <span class="themen-kachel__body">
    <span class="themen-kachel__title">{title}</span>
    {description && <span class="themen-kachel__desc">{description}</span>}
    <span class="themen-kachel__link" aria-hidden="true">Mehr erfahren →</span>
  </span>
</a>

<style>
  .themen-kachel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-width: 0;
    padding: var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .themen-kachel:hover,
  .themen-kachel:focus-visible {
    border-color: var(--color-bronze-soft);
    background-color: var(--color-background-alt);
  }

  .themen-kachel__icon {
    display: inline-flex;
    color: var(--color-petrol);
    flex-shrink: 0;
  }

  .themen-kachel__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .themen-kachel__title {
    font-weight: 700;
    color: var(--color-petrol);
    font-size: 1.0625rem; /* ca. 16–18px */
    line-height: 1.25;
  }

  .themen-kachel__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem; /* ca. 14–15px */
    line-height: 1.45;
  }

  .themen-kachel__link {
    margin-top: var(--space-2xs);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-bronze-dark);
  }
</style>
