---
interface NavLink {
  label: string;
  href: string;
}

interface NavGroup {
  label: string;
  items: NavLink[];
}

// Ein Untermenüpunkt ist entweder ein normaler Link oder eine verschachtelte,
// selbst wieder aufklappbare Gruppe (aktuell nur bei "Für Angehörige &
// Fachkräfte" genutzt).
type NavChild = NavLink | NavGroup;

function isGroup(child: NavChild): child is NavGroup {
  return "items" in child;
}

interface NavItem {
  label: string;
  href?: string;
  children?: NavChild[];
  // Richtet das Dropdown rechtsbündig aus, damit es bei Hauptpunkten nahe
  // am rechten Rand (Desktop/Tablet) nicht über den Viewport hinausragt.
  alignRight?: boolean;
}

// Nur tatsächlich vorhandene Seiten/Anker. Dropdowns gibt es ausschließlich
// dort, wo die Zielseite selbst bereits eine kleine, feste Anzahl echter
// Unterbereiche hat (Hub-Seite mit Bereichen, Ankerabschnitten oder eigenen
// Filterseiten). Anlaufstellen bleibt bewusst ein einfacher Link, da die
// Seite selbst keine feste, kleine Anzahl fester Unterbereiche anbietet.
//
// Die Gruppen "Für Angehörige" und "Für Fachkräfte" bilden die Themen aus
// den gleichnamigen Abschnitten von /angehoerige-fachkraefte/ ab (siehe
// angehoerigeGruppen/fachkraefteGruppen in src/pages/angehoerige-fachkraefte/
// index.astro). Mehrfach verlinkte Kacheln mit identischer Ziel-URL wurden
// zu einem Eintrag zusammengeführt; "Schule" und "Reizverarbeitung" sind
// bewusst in beiden Gruppen vorhanden, weil die Quellseite sie selbst für
// beide Zielgruppen führt.
const angehoerigeLinks: NavLink[] = [
  { label: "Autismus verstehen", href: "/fuer-autistische-menschen/was-ist-autismus/" },
  { label: "Kommunikation verstehen", href: "/fuer-autistische-menschen/kommunikation/" },
  { label: "Reizverarbeitung", href: "/fuer-autistische-menschen/reizverarbeitung/" },
  { label: "Verhalten einordnen", href: "/angehoerige-fachkraefte/autistisches-kind-begleiten/" },
  { label: "Unterstützung ohne Bevormundung", href: "/angehoerige-fachkraefte/unterstuetzung-ohne-bevormundung/" },
  { label: "Hilfen beantragen", href: "/fuer-autistische-menschen/rechte-und-antraege/" },
  {
    label: "Unterstützen, ohne dich selbst zu verlieren",
    href: "/angehoerige-fachkraefte/eigene-entlastung-fuer-angehoerige/",
  },
  { label: "Beziehungen", href: "/angehoerige-fachkraefte/partnerschaft-und-spaete-diagnose/" },
  { label: "Diagnose eines Kindes", href: "/angehoerige-fachkraefte/eltern-nach-der-diagnose/" },
  { label: "Schule und Kita", href: "/angehoerige-fachkraefte/schule-und-bildung/" },
  { label: "Nachteilsausgleiche", href: "/angehoerige-fachkraefte/nachteilsausgleich-und-schulbegleitung/" },
  { label: "Übergang ins Erwachsenenalter", href: "/angehoerige-fachkraefte/uebergang-ins-erwachsenenalter/" },
];

const fachkraefteLinks: NavLink[] = [
  { label: "Autismusfreundliche Kommunikation", href: "/fuer-autistische-menschen/kommunikation/" },
  { label: "Sensorische Bedürfnisse berücksichtigen", href: "/fuer-autistische-menschen/reizverarbeitung/" },
  { label: "Medizinische Fachkräfte", href: "/angehoerige-fachkraefte/medizinische-fachkraefte/" },
  { label: "Arzttermine gestalten", href: "/fuer-autistische-menschen/alltag/arzttermine/" },
  { label: "Psychotherapie & Beratung", href: "/angehoerige-fachkraefte/psychotherapie-und-beratung/" },
  { label: "Beratung & Sozialarbeit", href: "/angehoerige-fachkraefte/beratung-und-sozialarbeit/" },
  { label: "Schule", href: "/angehoerige-fachkraefte/schule-und-bildung/" },
  { label: "Pädagogische Fachkräfte", href: "/angehoerige-fachkraefte/paedagogische-fachkraefte/" },
  { label: "Arbeitsplatz", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  { label: "Arbeitgeber & Führungskräfte", href: "/angehoerige-fachkraefte/arbeitgeber-und-fuehrungskraefte/" },
];

// Materialtypen mit eigener Filterseite /materialien/typ/<typ>/ (siehe
// src/content.config.ts materialTypeLabels und src/pages/materialien/typ/
// [typ].astro). Nur Typen mit tatsächlich vorhandenen Materialien erzeugen
// dort eine Seite; "materialien-studium" hat aktuell keine Einträge und
// wird daher bewusst nicht verlinkt. Die vier häufigsten/größten Typen
// stehen als direkte Links im Dropdown, die übrigen (kleineren bzw.
// spezielleren) Typen sind in der Gruppe "Weitere Materialien" gebündelt,
// um das Menü nicht unnötig in die Breite zu ziehen.
const weitereMaterialien: NavLink[] = [
  { label: "Gesprächshilfen", href: "/materialien/typ/gespraechshilfen/" },
  { label: "Reizprofile", href: "/materialien/typ/reizprofile/" },
  { label: "Arzttermin-Vorbereitung", href: "/materialien/typ/arzttermin-vorbereitung/" },
  { label: "Tages- und Wochenplanung", href: "/materialien/typ/tages-wochenplanung/" },
  { label: "Belastungsprotokolle", href: "/materialien/typ/belastungsprotokolle/" },
  { label: "Antragschecklisten", href: "/materialien/typ/antragschecklisten/" },
  { label: "Materialien für Schule", href: "/materialien/typ/materialien-schule/" },
  { label: "Materialien für Arbeit", href: "/materialien/typ/materialien-arbeit/" },
];

// Shop-Unterpunkte bilden eine eigene verschachtelte Gruppe innerhalb des
// gemeinsamen Menüs "Material & Shop" (gleiches Muster wie "Für
// Angehörige"/"Für Fachkräfte" oben – maximal eine Verschachtelungsebene,
// wie auch vom Rendering unterstützt). Die Material-Links selbst stehen
// direkt auf oberster Ebene dieses Menüs (mit "Weitere Materialien" als
// eigener verschachtelter Gruppe, identisch zum bisherigen Dropdown) – alle
// vorher direkt erreichbaren Links bleiben dabei vollständig erhalten.
const shopLinks: NavLink[] = [
  { label: "Bücher", href: "/shop/#buecher" },
  { label: "Digitale Produkte", href: "/shop/#digitale-produkte" },
  { label: "Merchandise", href: "/shop/#merchandise" },
];

const items: NavItem[] = [
  {
    label: "Für Autist:innen",
    children: [
      { label: "Übersicht", href: "/fuer-autistische-menschen/" },
      { label: "Diagnostik & Tests", href: "/fuer-autistische-menschen/diagnostik/" },
      { label: "Rechte & Anträge", href: "/fuer-autistische-menschen/rechte-und-antraege/" },
      { label: "Alltag & Leben", href: "/fuer-autistische-menschen/alltag/" },
      { label: "Besonderheiten & Begleiterkrankungen", href: "/fuer-autistische-menschen/besonderheiten/" },
    ],
  },
  { label: "AuDHS", href: "/audhs/" },
  {
    label: "Wissen",
    children: [
      { label: "Autismus-Test", href: "/fuer-autistische-menschen/diagnostik/orientierungscheck/" },
      { label: "Glossar A–Z", href: "/glossar/" },
      { label: "Neurodivergenz verstehen", href: "/neurodivergenz/" },
    ],
  },
  {
    label: "Angehörige & Fachkräfte",
    children: [
      { label: "Übersicht", href: "/angehoerige-fachkraefte/" },
      { label: "Für Angehörige", items: angehoerigeLinks },
      { label: "Für Fachkräfte", items: fachkraefteLinks },
    ],
  },
  {
    label: "Material & Shop",
    alignRight: true,
    children: [
      { label: "Material: Übersicht", href: "/materialien/" },
      { label: "Kostenloser Leitfaden", href: "/materialien/#leitfaden" },
      { label: "Checklisten", href: "/materialien/typ/checklisten/" },
      { label: "Vorlagen", href: "/materialien/typ/vorlagen/" },
      { label: "Kommunikationshilfen", href: "/materialien/typ/kommunikationshilfen/" },
      { label: "Arbeitsblätter", href: "/materialien/typ/arbeitsblaetter/" },
      { label: "Weitere Materialien", items: weitereMaterialien },
      { label: "Shop: Übersicht", href: "/shop/" },
      { label: "Shop", items: shopLinks },
    ],
  },
  // "Anlaufstellen" und "Über mich" stehen bewusst NICHT in dieser
  // Hauptmenüliste: Mit 7 statt 5 Hauptpunkten ließe sich keine wirklich
  // einzeilige Desktop-Navigation mehr erreichen (siehe Abschlussbericht,
  // Abschnitt D – mit allen 7 Punkten plus Logo/Suche/CTA wäre die Zeile
  // erst ab ca. 1420px einzeilig, nicht schon ab realistischen
  // Desktop-Breiten). Beide bleiben aber direkt erreichbar: "Anlaufstellen"
  // als eigener, gut sichtbarer Link im Aktionsbereich neben Suche und
  // CTA (siehe Header.astro), "Über mich" als ruhiger Textlink daneben –
  // beides erfüllt "prominent/direkt erreichbar" bzw. "klar zugänglicher
  // Servicebereich" ohne ein zusätzliches, fast leeres "Mehr"-Dropdown.
];

const currentPath = Astro.url.pathname;

// Fragment (#...) spielt für den Seitenpfad keine Rolle.
function pathOf(href: string): string {
  return href.split("#")[0];
}

function isCurrentHref(href: string): boolean {
  const path = pathOf(href);
  return currentPath === path || (path !== "/" && currentPath.startsWith(path));
}

// Ob irgendein Link innerhalb von children (auch in verschachtelten
// Gruppen) zur aktuellen Seite passt – für die optische "aktiver
// Bereich"-Markierung der übergeordneten Buttons.
function hasActiveDescendant(children: NavChild[]): boolean {
  return children.some((child) => (isGroup(child) ? hasActiveDescendant(child.items) : isCurrentHref(child.href)));
}
---

<nav class="main-nav" aria-label="Hauptnavigation">
  <ul class="main-nav__list">
    {
      items.map((item, index) => {
        if (!item.children) {
          return (
            <li class="main-nav__item">
              <a href={item.href} aria-current={isCurrentHref(item.href!) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          );
        }

        const submenuId = `main-nav-submenu-${index}`;
        const isActiveSection = hasActiveDescendant(item.children);

        return (
          <li
            class:list={[
              "main-nav__item",
              "main-nav__item--has-children",
              { "main-nav__item--align-right": item.alignRight },
            ]}
          >
            {/* Ohne JavaScript ist das Untermenü immer sichtbar (siehe CSS);
               die Beschriftung bleibt dann als einfacher Text stehen (per
               CSS ausgeblendet, sobald JavaScript aktiv ist), da der Button
               ohne Skript nichts täte. */}
            <span class="main-nav__label-static">{item.label}</span>
            <button
              type="button"
              class:list={["main-nav__trigger", { "main-nav__trigger--active": isActiveSection }]}
              aria-expanded="false"
              aria-controls={submenuId}
            >
              {item.label}
              <svg class="main-nav__chevron" aria-hidden="true" viewBox="0 0 24 24" width="13" height="13">
                <path
                  d="M6 9l6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <ul class="main-nav__submenu" id={submenuId}>
              {item.children.map((child, childIndex) => {
                if (!isGroup(child)) {
                  return (
                    <li>
                      <a href={child.href} aria-current={isCurrentHref(child.href) ? "page" : undefined}>
                        {child.label}
                      </a>
                    </li>
                  );
                }

                const nestedId = `${submenuId}-${childIndex}`;
                const nestedActive = hasActiveDescendant(child.items);

                return (
                  <li class="main-nav__item--has-children main-nav__item--nested">
                    <span class="main-nav__label-static">{child.label}</span>
                    <button
                      type="button"
                      class:list={["main-nav__trigger", { "main-nav__trigger--active": nestedActive }]}
                      aria-expanded="false"
                      aria-controls={nestedId}
                    >
                      {child.label}
                      <svg
                        class="main-nav__chevron"
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        width="13"
                        height="13"
                      >
                        <path
                          d="M6 9l6 6 6-6"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="main-nav__submenu main-nav__submenu--nested" id={nestedId}>
                      {child.items.map((grandchild) => (
                        <li>
                          <a
                            href={grandchild.href}
                            aria-current={isCurrentHref(grandchild.href) ? "page" : undefined}
                          >
                            {grandchild.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                );
              })}
            </ul>
          </li>
        );
      })
    }
  </ul>
</nav>

<script is:inline>
  (function () {
    var nav = document.querySelector(".main-nav");
    if (!nav) return;

    var allTriggers = Array.from(nav.querySelectorAll(".main-nav__trigger"));

    function isOpen(trigger) {
      return trigger.getAttribute("aria-expanded") === "true";
    }

    function setOpen(trigger, open) {
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
    }

    function getContainer(trigger) {
      return trigger.closest("li");
    }

    // Direkte Kind-Trigger (eine Ebene tiefer), z. B. die beiden
    // Gruppen-Buttons innerhalb von "Für Angehörige & Fachkräfte".
    function getChildTriggers(trigger) {
      var container = getContainer(trigger);
      var submenu = container.querySelector(":scope > .main-nav__submenu");
      if (!submenu) return [];
      return Array.from(submenu.querySelectorAll(":scope > li > .main-nav__trigger"));
    }

    // Trigger auf derselben Verschachtelungsebene (Geschwister-<li>), die
    // beim Öffnen dieses Triggers exklusiv geschlossen werden.
    function getSiblingTriggers(trigger) {
      var container = getContainer(trigger);
      var parentList = container.parentElement;
      if (!parentList) return [];
      return Array.from(parentList.children)
        .map(function (li) {
          return li.querySelector(":scope > .main-nav__trigger");
        })
        .filter(function (candidate) {
          return candidate && candidate !== trigger;
        });
    }

    // Schließt einen Trigger und rekursiv alle noch offenen Kind-Trigger,
    // damit beim nächsten Öffnen keine verschachtelte Gruppe "hängen
    // bleibt".
    function closeTrigger(trigger) {
      setOpen(trigger, false);
      getChildTriggers(trigger).forEach(closeTrigger);
    }

    allTriggers.forEach(function (trigger) {
      trigger.addEventListener("click", function () {
        var wasOpen = isOpen(trigger);
        getSiblingTriggers(trigger).forEach(closeTrigger);
        if (wasOpen) {
          closeTrigger(trigger);
        } else {
          setOpen(trigger, true);
        }
      });
    });

    // Klick auf einen Untermenü-Link: Menü schließen (wichtig bei
    // Anker-Links auf die aktuell schon offene Seite, da dort kein voller
    // Seitenwechsel stattfindet).
    nav.querySelectorAll(".main-nav__submenu a").forEach(function (link) {
      link.addEventListener("click", function () {
        allTriggers.forEach(function (trigger) {
          setOpen(trigger, false);
        });
      });
    });

    document.addEventListener("click", function (event) {
      allTriggers.forEach(function (trigger) {
        var container = getContainer(trigger);
        if (!container.contains(event.target)) {
          setOpen(trigger, false);
        }
      });
    });

    document.addEventListener("keydown", function (event) {
      if (event.key !== "Escape") return;
      var openTriggers = allTriggers.filter(isOpen);
      if (openTriggers.length === 0) return;

      // Innersten offenen Trigger schließen: einer, dessen Kind-Trigger
      // (falls vorhanden) alle bereits geschlossen sind. Ein zweiter
      // Escape-Druck schließt danach die nächste Ebene.
      var innermost =
        openTriggers.find(function (trigger) {
          return getChildTriggers(trigger).every(function (child) {
            return !isOpen(child);
          });
        }) || openTriggers[openTriggers.length - 1];

      // Verhindert, dass ein zusätzlicher Escape-Handler (z. B. für das
      // mobile Hamburger-Menü in Header.astro) für denselben Tastendruck
      // ebenfalls auslöst und z. B. das ganze Menü schließt, bevor der
      // Fokus hierher zurückkehren konnte.
      event.stopImmediatePropagation();
      closeTrigger(innermost);
      innermost.focus();
    });
  })();
</script>

<style>
  /* Button-Design-Tokens dieser Navigation, abgeleitet aus der sitewide
     Petrol/Bronze-Palette (siehe global.css). Bronze kommt hier bewusst
     nur als zurückhaltender Akzent vor (Hover-Rahmen, Rand der
     verschachtelten Gruppen) – nie als Fläche oder Schriftfarbe. */
  .main-nav {
    --nav-item-bg: #e9f1f2;
    --nav-item-bg-hover: #d7e6e8;
    --nav-item-text: var(--color-petrol);
    --nav-item-active-bg: var(--color-petrol);
    --nav-item-active-bg-hover: var(--color-petrol-dark);
    --nav-item-active-text: var(--color-white);
    --nav-accent: #a56c3b;
  }

  .main-nav__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0;
  }

  .main-nav__item {
    position: relative;
  }

  /* Gemeinsames Button-Erscheinungsbild für alle Hauptmenüpunkte UND für
     verschachtelte Gruppen-Buttons: einfache Links ohne Unterthemen, der
     Trigger-Button mit JavaScript und die statische Beschriftung ohne
     JavaScript sehen optisch identisch aus – heller petrolgrauer Grund,
     dunkelpetrolfarbene Schrift, dezenter Rahmen, einheitliche Höhe und
     Innenabstände. Bewusst nicht auf ".main-nav__list > li >" beschränkt,
     da .main-nav__label-static und .main-nav__trigger unverändert gleich
     auch in verschachtelten Gruppen vorkommen (siehe weiter unten für die
     dort abweichende, randlose Variante). */
  .main-nav__list > li > a,
  .main-nav__label-static,
  html.js .main-nav__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    min-height: 2.25rem; /* 36px – kompakter, aber weiterhin über dem WCAG-2.2-Zielgrößen-Minimum von 24px */
    padding: var(--space-2xs);
    border-radius: var(--radius);
    background-color: var(--nav-item-bg);
    border: var(--border-width) solid var(--color-border);
    font: inherit;
    font-size: var(--font-size-sm); /* 14px */
    font-weight: 600;
    color: var(--nav-item-text);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  /* Die Beschriftung ohne JavaScript ist nicht interaktiv (das zugehörige
     Untermenü ist dann immer sichtbar, siehe unten) – daher kein
     Zeiger-Cursor, sie bleibt aber optisch identisch zum Button. */
  .main-nav__label-static {
    cursor: default;
  }

  .main-nav__list > li > a:hover,
  html.js .main-nav__trigger:hover {
    background-color: var(--nav-item-bg-hover);
    border-color: var(--nav-accent);
  }

  /* "Aktiv" (die aktuelle Seite liegt in diesem Menü) und "geöffnet"
     erhalten dieselbe kräftige Darstellung: volles Petrol, weiße Schrift.
     Gilt auf oberster Ebene ebenso wie für verschachtelte Gruppen-Buttons;
     der zusätzliche ".main-nav"-Klassenbezug erhöht die Spezifität bewusst
     über die der randlosen Standarddarstellung verschachtelter Gruppen
     (siehe weiter unten), damit eine geöffnete/aktive verschachtelte
     Gruppe dort zuverlässig die kräftige Füllung erhält. */
  .main-nav__list > li > a[aria-current="page"],
  html.js .main-nav .main-nav__trigger.main-nav__trigger--active,
  html.js .main-nav .main-nav__trigger[aria-expanded="true"] {
    background-color: var(--nav-item-active-bg);
    border-color: var(--nav-item-active-bg);
    color: var(--nav-item-active-text);
  }

  .main-nav__list > li > a[aria-current="page"]:hover,
  html.js .main-nav .main-nav__trigger.main-nav__trigger--active:hover,
  html.js .main-nav .main-nav__trigger[aria-expanded="true"]:hover {
    background-color: var(--nav-item-active-bg-hover);
    border-color: var(--nav-item-active-bg-hover);
  }

  .main-nav__trigger {
    display: none;
  }

  html.js .main-nav__label-static {
    display: none;
  }

  .main-nav__chevron {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  html.js .main-nav__trigger[aria-expanded="true"] .main-nav__chevron {
    transform: rotate(180deg);
  }

  /* Untermenü: ohne JavaScript immer sichtbar und Teil des normalen
     Seitenflusses, damit alle Unterseiten ohne Skript erreichbar bleiben.
     Gilt für oberste Ebene und verschachtelte Gruppen gleichermaßen. */
  .main-nav__submenu {
    list-style: none;
    margin: var(--space-2xs) 0 var(--space-sm) var(--space-sm);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .main-nav__submenu a {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--font-size-sm); /* 14px */
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .main-nav__submenu a:hover,
  .main-nav__submenu a:focus-visible {
    background-color: var(--color-background-alt);
  }

  .main-nav__submenu a[aria-current="page"] {
    color: var(--color-petrol);
    background-color: var(--color-background-alt);
  }

  /* Sobald JavaScript aktiv ist, wird das Untermenü standardmäßig
     verborgen und ausschließlich über aria-expanded am Button gesteuert.
     Diese Regel passt per Geschwister-Selektor auf jede Verschachtelungs-
     ebene (Button direkt gefolgt von seinem eigenen Untermenü). */
  html.js .main-nav__submenu {
    display: none;
  }

  html.js .main-nav__trigger[aria-expanded="true"] + .main-nav__submenu {
    display: flex;
  }

  /* Verschachtelte Gruppe: eigener, zurückhaltender Button-Stil ohne
     Flächenfarbe (nur Rahmen), damit die Hierarchie zum übergeordneten,
     flächig gefüllten Hauptpunkt erkennbar bleibt. Der schmale
     Bronze-Akzent am linken Rand macht zusätzlich sichtbar, dass hier eine
     eigene aufklappbare Gruppe beginnt ("Für Angehörige"/"Für
     Fachkräfte"/"Weitere Materialien"). */
  .main-nav__item--nested {
    padding-left: var(--space-sm);
    border-left: var(--border-width) solid var(--nav-accent);
  }

  li.main-nav__item--nested > .main-nav__label-static,
