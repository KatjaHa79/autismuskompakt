  { label: "Arbeitgeber & Führungskräfte", href: "/angehoerige-fachkraefte/arbeitgeber-und-fuehrungskraefte/" },
];

// Materialtypen mit eigener Filterseite /materialien/typ/<typ>/ (siehe
// src/content.config.ts materialTypeLabels und src/pages/materialien/typ/
// [typ].astro). Nur Typen mit tatsächlich vorhandenen Materialien erzeugen
// dort eine Seite; "materialien-studium" hat aktuell keine Einträge und
// wird daher bewusst nicht verlinkt. Die vier häufigsten/größten Typen
// stehen als direkte Links im Dropdown, die übrigen (kleineren bzw.
// spezielleren) Typen sind in der Gruppe "Weitere Materialien" gebündelt,
// um das Menü nicht unnötig in die Breite zu ziehen.
const weitereMaterialien: NavLink[] = [
  { label: "Gesprächshilfen", href: "/materialien/typ/gespraechshilfen/" },
  { label: "Reizprofile", href: "/materialien/typ/reizprofile/" },
  { label: "Arzttermin-Vorbereitung", href: "/materialien/typ/arzttermin-vorbereitung/" },
  { label: "Tages- und Wochenplanung", href: "/materialien/typ/tages-wochenplanung/" },
  { label: "Belastungsprotokolle", href: "/materialien/typ/belastungsprotokolle/" },
  { label: "Antragschecklisten", href: "/materialien/typ/antragschecklisten/" },
  { label: "Materialien für Schule", href: "/materialien/typ/materialien-schule/" },
  { label: "Materialien für Arbeit", href: "/materialien/typ/materialien-arbeit/" },
];

const items: NavItem[] = [
  {
    label: "Für Autist:innen",
    children: [
      { label: "Übersicht", href: "/fuer-autistische-menschen/" },
      { label: "Diagnostik & Tests", href: "/fuer-autistische-menschen/diagnostik/" },
      { label: "Rechte & Anträge", href: "/fuer-autistische-menschen/rechte-und-antraege/" },
      { label: "Alltag & Leben", href: "/fuer-autistische-menschen/alltag/" },
      { label: "Besonderheiten & Begleiterkrankungen", href: "/fuer-autistische-menschen/besonderheiten/" },
    ],
  },
  { label: "Autismus-Test", href: "/fuer-autistische-menschen/diagnostik/orientierungscheck/" },
  { label: "Glossar A–Z", href: "/glossar/" },
  {
    label: "Für Angehörige & Fachkräfte",
    children: [
      { label: "Übersicht", href: "/angehoerige-fachkraefte/" },
      { label: "Für Angehörige", items: angehoerigeLinks },
      { label: "Für Fachkräfte", items: fachkraefteLinks },
    ],
  },
  { label: "Anlaufstellen", href: "/hilfe-finden/" },
  {
    label: "Hilfreiches Material",
    children: [
      { label: "Übersicht", href: "/materialien/" },
      { label: "Kostenloser Leitfaden", href: "/materialien/#leitfaden" },
      { label: "Checklisten", href: "/materialien/typ/checklisten/" },
      { label: "Vorlagen", href: "/materialien/typ/vorlagen/" },
      { label: "Kommunikationshilfen", href: "/materialien/typ/kommunikationshilfen/" },
      { label: "Arbeitsblätter", href: "/materialien/typ/arbeitsblaetter/" },
      { label: "Weitere Materialien", items: weitereMaterialien },
    ],
  },
  {
    label: "Shop",
    alignRight: true,
    children: [
      { label: "Übersicht", href: "/shop/" },
      { label: "Bücher", href: "/shop/#buecher" },
      { label: "Digitale Produkte", href: "/shop/#digitale-produkte" },
      { label: "Merchandise", href: "/shop/#merchandise" },
    ],
  },
  { label: "Über mich", href: "/ueber-mich/" },
];

const currentPath = Astro.url.pathname;

// Fragment (#...) spielt für den Seitenpfad keine Rolle.
function pathOf(href: string): string {
  return href.split("#")[0];
}

function isCurrentHref(href: string): boolean {
  const path = pathOf(href);
  return currentPath === path || (path !== "/" && currentPath.startsWith(path));
}

// Ob irgendein Link innerhalb von children (auch in verschachtelten
// Gruppen) zur aktuellen Seite passt – für die optische "aktiver
// Bereich"-Markierung der übergeordneten Buttons.
function hasActiveDescendant(children: NavChild[]): boolean {
  return children.some((child) => (isGroup(child) ? hasActiveDescendant(child.items) : isCurrentHref(child.href)));
}
---

<nav class="main-nav" aria-label="Hauptnavigation">
  <ul class="main-nav__list">
    {
      items.map((item, index) => {
        if (!item.children) {
          return (
            <li class="main-nav__item">
              <a href={item.href} aria-current={isCurrentHref(item.href!) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          );
        }

        const submenuId = `main-nav-submenu-${index}`;
        const isActiveSection = hasActiveDescendant(item.children);

        return (
          <li
            class:list={[
              "main-nav__item",
              "main-nav__item--has-children",
              { "main-nav__item--align-right": item.alignRight },
            ]}
          >
            {/* Ohne JavaScript ist das Untermenü immer sichtbar (siehe CSS);
               die Beschriftung bleibt dann als einfacher Text stehen (per
               CSS ausgeblendet, sobald JavaScript aktiv ist), da der Button
               ohne Skript nichts täte. */}
            <span class="main-nav__label-static">{item.label}</span>
            <button
              type="button"
              class:list={["main-nav__trigger", { "main-nav__trigger--active": isActiveSection }]}
              aria-expanded="false"
              aria-controls={submenuId}
            >
              {item.label}
              <svg class="main-nav__chevron" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
                <path
                  d="M6 9l6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <ul class="main-nav__submenu" id={submenuId}>
              {item.children.map((child, childIndex) => {
                if (!isGroup(child)) {
                  return (
                    <li>
                      <a href={child.href} aria-current={isCurrentHref(child.href) ? "page" : undefined}>
                        {child.label}
                      </a>
                    </li>
                  );
                }

                const nestedId = `${submenuId}-${childIndex}`;
                const nestedActive = hasActiveDescendant(child.items);

                return (
                  <li class="main-nav__item--has-children main-nav__item--nested">
                    <span class="main-nav__label-static">{child.label}</span>
                    <button
                      type="button"
                      class:list={["main-nav__trigger", { "main-nav__trigger--active": nestedActive }]}
                      aria-expanded="false"
                      aria-controls={nestedId}
                    >
                      {child.label}
                      <svg
                        class="main-nav__chevron"
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                      >
                        <path
                          d="M6 9l6 6 6-6"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="main-nav__submenu main-nav__submenu--nested" id={nestedId}>
                      {child.items.map((grandchild) => (
                        <li>
                          <a
                            href={grandchild.href}
                            aria-current={isCurrentHref(grandchild.href) ? "page" : undefined}
                          >
                            {grandchild.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                );
              })}
            </ul>
          </li>
        );
      })
    }
  </ul>
</nav>

<script is:inline>
  (function () {
    var nav = document.querySelector(".main-nav");
    if (!nav) return;

    var allTriggers = Array.from(nav.querySelectorAll(".main-nav__trigger"));

    function isOpen(trigger) {
      return trigger.getAttribute("aria-expanded") === "true";
    }

    function setOpen(trigger, open) {
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
    }

    function getContainer(trigger) {
      return trigger.closest("li");
    }

    // Direkte Kind-Trigger (eine Ebene tiefer), z. B. die beiden
    // Gruppen-Buttons innerhalb von "Für Angehörige & Fachkräfte".
    function getChildTriggers(trigger) {
      var container = getContainer(trigger);
      var submenu = container.querySelector(":scope > .main-nav__submenu");
      if (!submenu) return [];
      return Array.from(submenu.querySelectorAll(":scope > li > .main-nav__trigger"));
    }

    // Trigger auf derselben Verschachtelungsebene (Geschwister-<li>), die
    // beim Öffnen dieses Triggers exklusiv geschlossen werden.
    function getSiblingTriggers(trigger) {
      var container = getContainer(trigger);
      var parentList = container.parentElement;
      if (!parentList) return [];
      return Array.from(parentList.children)
        .map(function (li) {
          return li.querySelector(":scope > .main-nav__trigger");
        })
        .filter(function (candidate) {
          return candidate && candidate !== trigger;
        });
    }

    // Schließt einen Trigger und rekursiv alle noch offenen Kind-Trigger,
    // damit beim nächsten Öffnen keine verschachtelte Gruppe "hängen
    // bleibt".
    function closeTrigger(trigger) {
      setOpen(trigger, false);
      getChildTriggers(trigger).forEach(closeTrigger);
    }

    allTriggers.forEach(function (trigger) {
      trigger.addEventListener("click", function () {
        var wasOpen = isOpen(trigger);
        getSiblingTriggers(trigger).forEach(closeTrigger);
        if (wasOpen) {
          closeTrigger(trigger);
        } else {
          setOpen(trigger, true);
        }
      });
    });

    // Klick auf einen Untermenü-Link: Menü schließen (wichtig bei
    // Anker-Links auf die aktuell schon offene Seite, da dort kein voller
    // Seitenwechsel stattfindet).
    nav.querySelectorAll(".main-nav__submenu a").forEach(function (link) {
      link.addEventListener("click", function () {
        allTriggers.forEach(function (trigger) {
          setOpen(trigger, false);
        });
      });
    });

    document.addEventListener("click", function (event) {
      allTriggers.forEach(function (trigger) {
        var container = getContainer(trigger);
        if (!container.contains(event.target)) {
          setOpen(trigger, false);
        }
      });
    });

    document.addEventListener("keydown", function (event) {
      if (event.key !== "Escape") return;
      var openTriggers = allTriggers.filter(isOpen);
      if (openTriggers.length === 0) return;

      // Innersten offenen Trigger schließen: einer, dessen Kind-Trigger
      // (falls vorhanden) alle bereits geschlossen sind. Ein zweiter
      // Escape-Druck schließt danach die nächste Ebene.
      var innermost =
        openTriggers.find(function (trigger) {
          return getChildTriggers(trigger).every(function (child) {
            return !isOpen(child);
          });
        }) || openTriggers[openTriggers.length - 1];

      // Verhindert, dass ein zusätzlicher Escape-Handler (z. B. für das
      // mobile Hamburger-Menü in Header.astro) für denselben Tastendruck
      // ebenfalls auslöst und z. B. das ganze Menü schließt, bevor der
      // Fokus hierher zurückkehren konnte.
      event.stopImmediatePropagation();
      closeTrigger(innermost);
      innermost.focus();
    });
  })();
</script>

<style>
  .main-nav__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding: 0;
  }

  .main-nav__item {
    position: relative;
  }

  .main-nav__list > li > a {
    display: inline-block;
    padding: var(--space-xs) 0;
    font-size: 0.85rem; /* ca. 13,5–14px */
    color: var(--color-petrol);
    text-decoration: none;
    font-weight: 700;
    border-bottom: 2px solid transparent;
  }

  .main-nav__list > li > a:hover {
    border-bottom-color: var(--color-bronze-soft);
  }

  .main-nav__list > li > a[aria-current="page"] {
    border-bottom-color: var(--color-bronze);
  }

  /* Beschriftung ohne JavaScript: einfacher Text statt Button, da der
     Button ohne Skript nicht funktionieren würde. Das zugehörige Untermenü
     ist in diesem Fall immer sichtbar (siehe unten), die Seite bleibt also
     vollständig nutzbar. Gilt gleichermaßen für die oberste Ebene und für
     verschachtelte Gruppen. */
  .main-nav__label-static {
    display: block;
    padding: var(--space-xs) 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-petrol);
  }

  .main-nav__trigger {
    display: none;
  }

  html.js .main-nav__label-static {
    display: none;
  }

  html.js .main-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) 0;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-petrol);
    cursor: pointer;
  }

  html.js .main-nav__trigger:hover {
    border-bottom-color: var(--color-bronze-soft);
  }

  html.js .main-nav__trigger--active {
    border-bottom-color: var(--color-bronze);
  }

  .main-nav__chevron {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  html.js .main-nav__trigger[aria-expanded="true"] .main-nav__chevron {
    transform: rotate(180deg);
  }

  /* Untermenü: ohne JavaScript immer sichtbar und Teil des normalen
     Seitenflusses, damit alle Unterseiten ohne Skript erreichbar bleiben.
     Gilt für oberste Ebene und verschachtelte Gruppen gleichermaßen. */
  .main-nav__submenu {
    list-style: none;
    margin: var(--space-2xs) 0 var(--space-sm) var(--space-sm);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .main-nav__submenu a {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .main-nav__submenu a:hover,
  .main-nav__submenu a:focus-visible {
    background-color: var(--color-background-alt);
  }

  .main-nav__submenu a[aria-current="page"] {
    color: var(--color-petrol);
    background-color: var(--color-background-alt);
  }

  /* Sobald JavaScript aktiv ist, wird das Untermenü standardmäßig
     verborgen und ausschließlich über aria-expanded am Button gesteuert.
     Diese Regel passt per Geschwister-Selektor auf jede Verschachtelungs-
     ebene (Button direkt gefolgt von seinem eigenen Untermenü). */
  html.js .main-nav__submenu {
    display: none;
  }

  html.js .main-nav__trigger[aria-expanded="true"] + .main-nav__submenu {
    display: flex;
  }

  /* Verschachtelte Gruppe: dezent eingerückt und mit einer schmalen
     Linie abgesetzt, damit die Zugehörigkeit zur übergeordneten Gruppe
     ("Für Angehörige"/"Für Fachkräfte") auch optisch klar bleibt. */
  .main-nav__item--nested {
    padding-left: var(--space-sm);
    border-left: var(--border-width) solid var(--color-border);
  }

  /* Lange Themenlisten innerhalb einer verschachtelten Gruppe bleiben
     bedienbar: eigener Scrollbereich statt eines endlos wachsenden
     Panels. Die Gruppen-Buttons selbst bleiben dabei immer sichtbar. */
  html.js .main-nav__submenu--nested {
    max-height: 60vh;
    overflow-y: auto;
  }

  /* Ab Desktop/Tablet-Breite (identisch zur bestehenden Hamburger-Schwelle)
     klappt das Untermenü als schwebendes, reizarmes Panel unterhalb des
     Hauptpunkts auf. */
  @media (min-width: 40.0625rem) {
    html.js .main-nav__submenu {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 20;
      margin: 0;
      min-width: 16rem;
      max-width: min(22rem, calc(100vw - 2 * var(--space-md)));
      padding: var(--space-2xs);
      background-color: var(--color-surface);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius);
    }

    /* Für Hauptpunkte nahe am rechten Rand (z. B. "Shop") rechtsbündig und
       schmaler ausrichten: Rechtsbündig verhindert das Hinausragen über
       den rechten Rand, eine geringere Breite verhindert gleichzeitig ein
       Hinausragen über den linken Rand (siehe Punkt 9 des Auftrags). */
    .main-nav__item--align-right .main-nav__submenu {
      left: auto;
      right: 0;
      min-width: 11rem;
      max-width: min(14rem, calc(100vw - 2 * var(--space-md)));
    }

    /* Verschachtelte Gruppen schweben nicht zusätzlich als eigenes Panel
       (das würde zu Überlagerungen führen), sondern klappen innerhalb des
       bereits geöffneten übergeordneten Panels normal nach unten auf –
       "unmittelbar darunter", wie im Auftrag gefordert. */
    html.js .main-nav__submenu.main-nav__submenu--nested {
      position: static;
      min-width: 0;
      max-width: none;
      padding: 0;
      background: transparent;
      border: none;
    }
  }

  /* Unter der Hamburger-Schwelle: Untermenü klappt inline direkt unter dem
     Hauptpunkt auf, kein schwebendes Panel (vermeidet Überlagerungen auf
     schmalen Bildschirmen). Gilt unverändert auch für verschachtelte
     Gruppen, die dort ohnehin bereits "static" positioniert sind. */
  @media (max-width: 40rem) {
    html.js .main-nav__submenu {
      position: static;
      margin: var(--space-2xs) 0 var(--space-sm) var(--space-sm);
      padding: 0;
      background: transparent;
      border: none;
      max-width: none;
    }

    html.js .main-nav__submenu--nested {
      max-height: none;
      overflow-y: visible;
    }

    html.js .main-nav__list {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: var(--space-2xs);
    }

    html.js .main-nav__list > li > a {
      display: block;
      padding: var(--space-xs) 0;
    }
  }
</style>
