const fachkraefteLinks: NavLink[] = [
  { label: "Autismusfreundliche Kommunikation", href: "/fuer-autistische-menschen/kommunikation/" },
  { label: "Sensorische Bedürfnisse berücksichtigen", href: "/fuer-autistische-menschen/reizverarbeitung/" },
  { label: "Medizinische Fachkräfte", href: "/angehoerige-fachkraefte/medizinische-fachkraefte/" },
