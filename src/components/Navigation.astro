---
interface NavLink {
  label: string;
  href: string;
}

interface NavGroup {
  label: string;
  items: NavLink[];
}

// Ein Untermenüpunkt ist entweder ein normaler Link oder eine verschachtelte,
// selbst wieder aufklappbare Gruppe (aktuell nur bei "Für Angehörige &
// Fachkräfte" genutzt).
type NavChild = NavLink | NavGroup;

function isGroup(child: NavChild): child is NavGroup {
  return "items" in child;
}

interface NavItem {
  label: string;
  href?: string;
  children?: NavChild[];
  // Richtet das Dropdown rechtsbündig aus, damit es bei Hauptpunkten nahe
  // am rechten Rand (Desktop/Tablet) nicht über den Viewport hinausragt.
  alignRight?: boolean;
}

// Nur tatsächlich vorhandene Seiten/Anker. Dropdowns gibt es ausschließlich
// dort, wo die Zielseite selbst bereits eine kleine, feste Anzahl echter
// Unterbereiche hat (Hub-Seite mit Bereichen, Ankerabschnitten oder eigenen
// Filterseiten). Anlaufstellen bleibt bewusst ein einfacher Link, da die
// Seite selbst keine feste, kleine Anzahl fester Unterbereiche anbietet.
//
// Die Gruppen "Für Angehörige" und "Für Fachkräfte" bilden die Themen aus
// den gleichnamigen Abschnitten von /angehoerige-fachkraefte/ ab (siehe
// angehoerigeGruppen/fachkraefteGruppen in src/pages/angehoerige-fachkraefte/
// index.astro). Mehrfach verlinkte Kacheln mit identischer Ziel-URL wurden
// zu einem Eintrag zusammengeführt; "Schule" und "Reizverarbeitung" sind
// bewusst in beiden Gruppen vorhanden, weil die Quellseite sie selbst für
// beide Zielgruppen führt.
