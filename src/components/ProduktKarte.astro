---
import type { CollectionEntry } from "astro:content";
import { productTypeLabels, productButtonLabels, targetGroupLabels } from "../content.config";

interface Props {
  entry: CollectionEntry<"produkte">;
}

const { entry } = Astro.props;
const { title, subtitle, description, cover, productType, targetGroups, externalUrl, provider, buttonLabel, demo } =
  entry.data;

const label = buttonLabel ?? productButtonLabels[productType];
const istBuch = productType === "buch";
---

<article class:list={["produkt-karte", istBuch && "produkt-karte--buch"]} id={entry.id}>
  {
    cover ? (
      <img
        class:list={["cover", istBuch && "cover--buch"]}
        src={cover}
        alt={`Buchcover ${title}${subtitle ? ` – ${subtitle}` : ""} von Katja Hageneier`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <p class="cover cover--placeholder placeholder">Cover folgt</p>
    )
  }

  <h3>
    {title}
    {demo && <span class="demo-badge">Beispieldatensatz</span>}
  </h3>

  {subtitle && <p class="untertitel">{subtitle}</p>}

  <p class="typ">{productTypeLabels[productType]}</p>

  {productType === "buch" && <p class="autorin">Autorin: Katja Hageneier</p>}

  <p class="beschreibung">{description}</p>

  <p class="zielgruppen">Für: {targetGroups.map((gruppe) => targetGroupLabels[gruppe]).join(", ")}</p>

  {provider && <p class="anbieter">Anbieter: {provider}</p>}

  <a class="button button--secondary" href={externalUrl} rel="noopener noreferrer">
    {label} <span aria-hidden="true">↗</span>
    <span class="visually-hidden">(öffnet auf einer anderen Website)</span>
  </a>
</article>

<style>
  .produkt-karte {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }

  .cover {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-2xs);
  }

  /* Buchcover unverändert und vollständig im eigenen Seitenverhältnis
     zeigen statt zuzuschneiden oder zu verzerren. */
  .cover--buch {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 28rem;
    aspect-ratio: auto;
    object-fit: contain;
    margin-inline: auto;
  }

  .cover--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .produkt-karte--buch {
    border: none;
    background-color: transparent;
    padding: 0;
  }

  .produkt-karte h3 {
    font-size: 1.15rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .produkt-karte--buch h3 {
    font-size: 1.35rem;
    margin-top: var(--space-xs);
  }

  .untertitel {
    font-style: italic;
    color: var(--color-text-muted);
  }

  .autorin {
    font-size: 0.9rem;
  }

  .demo-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-bronze-dark);
    background-color: var(--color-background-alt);
    border: var(--border-width) solid var(--color-bronze-dark);
    border-radius: 999px;
    padding: 0.15em 0.6em;
  }

  .typ {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .beschreibung {
    font-size: 0.95rem;
  }

  .zielgruppen {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .anbieter {
    font-size: 0.85rem;
  }

  .produkt-karte .button {
    margin-top: var(--space-xs);
    align-self: flex-start;
    white-space: nowrap;
  }
</style>
