---
import Navigation from "./Navigation.astro";
import { BREVO_LEITFADEN_URL } from "../lib/constants";

const currentPath = Astro.url.pathname;
const isAnlaufstellen = currentPath === "/hilfe-finden/" || currentPath.startsWith("/hilfe-finden/");
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <div class="site-header__top">
      <a class="site-header__logo" href="/" aria-label="Autismuskompakt – Startseite">
        <img
          class="site-header__logo-img"
          src="/logo/autismuskompakt-logo.png"
          alt=""
          width="557"
          height="560"
        />
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="primary-menu"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
          <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
          <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
          <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        </svg>
        <span>Menü</span>
      </button>
    </div>

    <div id="primary-menu" class="primary-menu">
      <Navigation />

      <div class="primary-menu__actions">
        <a
          class="site-header__quicklink"
          href="/hilfe-finden/"
          aria-current={isAnlaufstellen ? "page" : undefined}
        >
          Anlaufstellen
        </a>

        <a class="site-header__cta button button--accent" href={BREVO_LEITFADEN_URL}>
          Kostenloser Leitfaden
        </a>

        <div class="site-header__search-row">
          <form class="site-header__search" action="/suche/" method="get" role="search">
            <label class="visually-hidden" for="site-search">Website durchsuchen</label>
            <input
              id="site-search"
              name="q"
              type="search"
              placeholder="Suchen …"
              autocomplete="off"
            />
            <button type="submit">
              <span class="visually-hidden">Suchen</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
                <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <line x1="16.6" y1="16.6" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
              </svg>
            </button>
          </form>
        </div>

        <a class="site-header__quietlink" href="/ueber-mich/">Über mich</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById("nav-toggle");
    var panel = document.getElementById("primary-menu");
    if (!toggle || !panel) return;

    var mq = window.matchMedia("(max-width: 40rem)");

    function collapse() {
      panel.style.display = "none";
      toggle.setAttribute("aria-expanded", "false");
    }

    function expand() {
      panel.style.display = "";
      toggle.setAttribute("aria-expanded", "true");
    }

    function syncToBreakpoint() {
      if (mq.matches) {
        collapse();
      } else {
        panel.style.display = "";
        toggle.setAttribute("aria-expanded", "false");
      }
    }

    syncToBreakpoint();
    mq.addEventListener("change", syncToBreakpoint);

    toggle.addEventListener("click", function () {
      if (!mq.matches) return;
      if (panel.style.display === "none") {
        expand();
      } else {
        collapse();
      }
    });

    panel.addEventListener("click", function (event) {
      if (mq.matches && event.target.closest("a")) {
        collapse();
      }
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && mq.matches && panel.style.display !== "none") {
        // Ist gerade ein Dropdown-Untermenü offen (siehe Navigation.astro),
        // schließt ein Escape-Druck zuerst nur dieses. Erst ein zweiter
        // Druck schließt das gesamte mobile Menü.
        if (panel.querySelector('.main-nav__trigger[aria-expanded="true"]')) return;
        collapse();
        toggle.focus();
      }
    });
  })();
</script>

<style>
  /* Heller, editorieller Header statt großflächigem dunklem Petrol –
     das Logo trägt die Markenwirkung, nicht die Headerfläche. */
  .site-header {
    background-color: var(--color-surface);
    color: var(--color-text);
    border-bottom: var(--border-width) solid var(--color-border);
    padding-block: var(--space-sm);
  }

  .site-header__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .site-header__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__logo-img {
    display: block;
    width: auto;
    height: 3.25rem;
  }

  /* Sehr schmale Bildschirme: Logo etwas kleiner, damit es zusammen mit der
     Menü-Schaltfläche ohne horizontales Scrollen in eine Zeile passt –
     aber weiterhin klar als Marke erkennbar (Ziel ca. 55–70px sichtbar). */
  @media (max-width: 23rem) {
    .site-header__logo-img {
      height: 3rem;
    }
  }

  @media (min-width: 23.0625rem) and (max-width: 40rem) {
    .site-header__logo-img {
      height: 3.5rem;
    }
  }

  /* Ab hier genug Platz: Logo, Navigation und CTA teilen sich eine Zeile.
     Kompakter als zuvor (vorher 110px), damit das Logo harmonisch neben der
     verschlankten, einzeiligen Navigation wirkt, statt den Header zu
     dominieren – bleibt mit 72px weiterhin klar als Marke erkennbar. */
  @media (min-width: 40.0625rem) {
    .site-header__logo-img {
      height: 4.5rem;
    }
  }

  /* Hamburger-Schaltfläche: nur auf schmalen Bildschirmen und nur, wenn
     JavaScript verfügbar ist (siehe html.js in BaseLayout.astro). Ohne
     JavaScript bleibt die Navigation immer sichtbar und umbricht wie
     gewohnt – die Schaltfläche erscheint dann gar nicht erst. */
  .nav-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2xs);
    background: transparent;
    border: var(--border-width) solid var(--color-petrol);
    color: var(--color-petrol);
    border-radius: var(--radius);
    padding: var(--space-2xs) var(--space-sm);
    font-weight: 700;
    min-height: 44px;
  }

  .primary-menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
  }

  .primary-menu__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }

  /* Zurückhaltender als der Standard-Button: sichtbar, aber weder
     größer noch schwerer wirkend als Logo und Navigation. */
  .site-header__cta {
    white-space: nowrap;
    padding-block: var(--space-2xs);
    padding-inline: var(--space-sm);
    font-size: var(--font-size-sm); /* 14px */
    min-height: 38px;
  }

  /* "Anlaufstellen" steht bewusst außerhalb der Hauptmenüliste (siehe
     Navigation.astro), bleibt aber genauso prominent/eigenständig wie die
     übrigen Hauptpunkte – gleiche Chip-Optik wie main-nav, nur hier im
     Aktionsbereich neben Suche und CTA platziert. */
  .site-header__quicklink {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    min-height: 2.25rem;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius);
    background-color: #e9f1f2;
    border: var(--border-width) solid var(--color-border);
    font-size: var(--font-size-sm); /* 14px */
    font-weight: 600;
    color: var(--color-petrol);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .site-header__quicklink:hover {
    background-color: #d7e6e8;
    border-color: #a56c3b;
  }

  .site-header__quicklink[aria-current="page"] {
    background-color: var(--color-petrol);
    border-color: var(--color-petrol);
    color: var(--color-white);
  }

  /* "Über mich" ist bewusst zurückhaltender als "Anlaufstellen": ein
     ruhiger Textlink ohne Chip-Fläche, da es sich um ein weniger
     frequentiertes Serviceziel handelt (siehe Abschlussbericht). */
  .site-header__quietlink {
    white-space: nowrap;
    font-size: var(--font-size-sm); /* 14px */
    font-weight: 600;
    color: var(--color-petrol);
    text-decoration: none;
  }

  .site-header__quietlink:hover {
    text-decoration: underline;
  }

  .site-header__search-row {
    display: flex;
  }

  .site-header__search {
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  .site-header__search input {
    border: var(--border-width) solid var(--color-text-muted);
    background-color: var(--color-background);
    color: var(--color-text);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius) 0 0 var(--radius);
    min-height: 42px;
    width: 11rem;
    max-width: 40vw;
  }

  .site-header__search button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    min-height: 42px;
    padding-inline: var(--space-xs);
    background-color: var(--color-petrol-dark);
    color: var(--color-white);
    border: none;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .site-header__search button:hover {
    background-color: var(--color-petrol);
  }

  @media (max-width: 40rem) {
    html.js .nav-toggle {
      display: inline-flex;
    }

    html.js .primary-menu {
      display: block;
      padding-top: var(--space-sm);
      border-top: var(--border-width) solid var(--color-border);
    }

    html.js .primary-menu__actions {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-sm);
      margin-top: var(--space-sm);
    }

    html.js .site-header__cta {
      justify-content: center;
    }
  }

  /* Ab hier teilen sich Logo und Navigation eine Zeile; Leitfaden-Button und
     Suche rücken als ruhige, kompakte zweite Zeile darunter. Erst ab der
     Einzeilen-Schwelle (siehe unten, ca. 1024px) reiht sich alles – Logo,
     Navigation, Suche und CTA – in einer einzigen Zeile aneinander. */
  @media (min-width: 40.0625rem) and (max-width: 81.9375rem) {
    .site-header__inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-lg);
      row-gap: var(--space-sm);
    }

    .site-header__top {
      flex: 0 0 auto;
    }

    .primary-menu {
      flex: 1 1 0%;
      min-width: 0;
    }

    .primary-menu :global(.main-nav) {
      flex: 1 1 auto;
    }

    .primary-menu__actions {
      flex-basis: 100%;
      justify-content: flex-end;
    }
  }

  /* Ab ca. 1312px genug Breite für eine einzige ruhige Zeile: Logo,
     Navigation, Suche, Anlaufstellen, "Über mich" und CTA nebeneinander.
     Reihenfolge per order bewusst gesetzt, unabhängig von der
     DOM-Reihenfolge im Markup. Abstände fallen hier knapper aus, damit
     Logo und Navigation nicht unnötig auseinanderrücken. Der Breakpoint
     wurde empirisch mit Playwright kalibriert (schrittweise Messung des
     tatsächlichen Umbruchpunkts der 5-teiligen Hauptnavigation plus
     Aktionsbereich, nicht anhand eines geschätzten Gerätewerts): echter
     Umbruch bei ca. 1300px, dieser Wert plus Sicherheitsabstand für
     abweichendes Schrift-Rendering in anderen Browsern/Betriebssystemen.
     Siehe Abschlussbericht, Abschnitt D. */
  @media (min-width: 82rem) {
    .site-header__inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-xs);
      row-gap: var(--space-sm);
    }

    .site-header__top {
      flex: 0 0 auto;
      order: 0;
    }

    .primary-menu {
      flex: 1 1 0%;
      min-width: 0;
      column-gap: var(--space-2xs);
      order: 1;
    }

    .primary-menu :global(.main-nav) {
      flex: 1 1 0%;
      min-width: 0;
    }

    .primary-menu :global(.main-nav__list) {
      column-gap: var(--space-sm);
    }

    .primary-menu__actions {
      display: contents;
    }

    .site-header__quicklink {
      flex: 0 0 auto;
      order: 2;
    }

    .site-header__search-row {
      flex: 0 0 auto;
      order: 3;
    }

    .site-header__quietlink {
      flex: 0 0 auto;
      order: 4;
    }

    .site-header__cta {
      flex: 0 0 auto;
      padding-inline: var(--space-sm);
      font-size: var(--font-size-sm); /* 14px */
      order: 5;
    }

    /* Dezente, ikonbasierte Suche: nimmt in der Einzeilen-Kopfzeile nur so
       viel Platz wie der Icon-Button ein und blendet das Eingabefeld erst
       bei Fokus/Eingabe ein (keine neue Suchlogik, nur eine kompaktere
       Präsentation derselben Suche). */
    .site-header__search input {
      width: 0;
      min-height: 38px;
      padding-inline: 0;
      border-width: 0;
      opacity: 0;
    }

    .site-header__search:focus-within input,
    .site-header__search input:not(:placeholder-shown) {
      width: 9rem;
      padding-inline: var(--space-2xs);
      border-width: var(--border-width);
      opacity: 1;
    }

    .site-header__search button {
      min-width: 38px;
      min-height: 38px;
    }
  }

  @media (max-width: 40rem) {
    .site-header__search input {
      width: 100%;
      max-width: none;
      flex: 1;
    }
  }
</style>
