---
import Navigation from "./Navigation.astro";
---

<header class="site-header on-dark">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/">
      Autismuskompakt
    </a>

    <Navigation />

    <form class="site-header__search" action="/suche/" method="get" role="search">
      <label class="visually-hidden" for="site-search">Website durchsuchen</label>
      <input
        id="site-search"
        name="q"
        type="search"
        placeholder="Suchen …"
        autocomplete="off"
      />
      <button type="submit">
        <span class="visually-hidden">Suchen</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <line x1="16.6" y1="16.6" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        </svg>
      </button>
    </form>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-petrol-700);
    color: var(--color-text-invert);
    padding-block: var(--space-sm);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
  }

  .site-header__logo {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-text-invert);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__search {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-inline-start: auto;
  }

  .site-header__search input {
    border: var(--border-width) solid var(--color-petrol-600);
    background-color: var(--color-creme);
    color: var(--color-text);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius) 0 0 var(--radius);
    min-height: 44px;
    width: 12rem;
    max-width: 40vw;
  }

  .site-header__search button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding-inline: var(--space-xs);
    background-color: var(--color-kupfer-800);
    color: var(--color-white);
    border: none;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .site-header__search button:hover {
    background-color: #733610;
  }

  @media (max-width: 40rem) {
    .site-header__search {
      margin-inline-start: 0;
      width: 100%;
    }

    .site-header__search input {
      width: 100%;
      max-width: none;
      flex: 1;
    }
  }
</style>
