---
type Topic = string | { label: string; href: string };

interface Props {
  topics: Topic[];
}

const { topics } = Astro.props;
---

<ul class="planned-topics">
  {
    topics.map((topic) =>
      typeof topic === "string" ? (
        <li>{topic}</li>
      ) : (
        <li>
          <a href={topic.href}>{topic.label}</a>
        </li>
      ),
    )
  }
</ul>

<style>
  .planned-topics {
    list-style: disc;
    padding-inline-start: 1.25em;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-2xs) var(--space-md);
    max-width: none;
  }
</style>
