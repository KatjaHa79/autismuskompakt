---
interface Props {
  topics: string[];
}

const { topics } = Astro.props;
---

<ul class="planned-topics">
  {topics.map((topic) => <li>{topic}</li>)}
</ul>

<style>
  .planned-topics {
    list-style: disc;
    padding-inline-start: 1.25em;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-2xs) var(--space-md);
    max-width: none;
  }
</style>
