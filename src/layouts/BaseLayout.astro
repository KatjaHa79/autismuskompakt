---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  // Wenn true, wird KEIN automatischer " · Autismuskompakt"-Zusatz an den
  // Title angehängt, weil der übergebene Title bereits selbst den
  // vollständigen, gebrandeten SEO-Title enthält (z. B. "... | AUTISMUS
  // kompakt"). Default false hält das bisherige Verhalten für alle
  // anderen Seiten unverändert bei.
  fullTitle?: boolean;
  // Absoluter oder site-relativer Pfad zu einem abweichenden Vorschaubild
  // (z. B. ein Artikelbild). Ohne Angabe greift das zentrale
  // Standard-Vorschaubild (1200×630, abgeleitet aus dem Hero-Stillleben).
  ogImage?: string;
  // Optionaler robots-Meta-Inhalt (z. B. "noindex, follow") für Seiten mit
  // abweichenden Indexierungsvorgaben – interne Suchergebnisseite,
  // Fehlerseite, Double-Opt-in-Bestätigungsseite. Ohne Angabe wird KEIN
  // robots-Tag ausgegeben (Standardverhalten entspricht weiterhin "index,
  // follow" über die Abwesenheit des Tags, wie bisher bei allen Seiten).
  robots?: string;
}

const { title, description, fullTitle = false, ogImage = "/images/og/og-default.jpg", robots } = Astro.props;
const pageTitle = fullTitle ? title : `${title} · Autismuskompakt`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:site_name" content="Autismuskompakt" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Autismuskompakt – Vase, Bücher und Bilderrahmen auf Holzregal vor petrolfarbener Wand" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="hauptinhalt">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
