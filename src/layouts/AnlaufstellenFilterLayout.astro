---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AnlaufstelleKarte from "../components/AnlaufstelleKarte.astro";
import { getFacetRobots } from "../lib/indexierung";
import { ANLAUFSTELLEN_DATENHINWEIS } from "../lib/bundesland-seo";

interface Props {
  title: string;
  filterLabel: string;
  entries: CollectionEntry<"anlaufstellen">[];
  // Optionale Overrides für redaktionell individuell gepflegte Facetten
  // (aktuell: die 16 Bundesland-Seiten, siehe bundesland-seo.ts). Ohne
  // Angabe unverändertes bisheriges Verhalten (automatisch generierter
  // Title/Description aus title/filterLabel) für alle anderen Facetten
  // (Kategorie, Zielgruppe, Altersgruppe, Online, Vor Ort).
  seoTitle?: string;
  metaDescription?: string;
  introText?: string;
}

const { title, filterLabel, entries, seoTitle, metaDescription, introText } = Astro.props;
const robots = getFacetRobots(Astro.url.pathname);
---

<BaseLayout
  title={seoTitle ?? `${title} – Anlaufstellen`}
  description={metaDescription ?? `Anlaufstellen zum Thema Autismus, gefiltert nach: ${filterLabel}.`}
  fullTitle={Boolean(seoTitle)}
  robots={robots}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Anlaufstellen", href: "/hilfe-finden/" },
        { label: title },
      ]}
    />
  </div>

  <section class="section">
    <div class="container">
      <h1>{title}</h1>

      {
        introText && (
          <div class="facette-intro">
            <p>{introText}</p>
            <p class="facette-intro__hinweis">{ANLAUFSTELLEN_DATENHINWEIS}</p>
          </div>
        )
      }

      <p class="lead">
        <a href="/hilfe-finden/">Zurück zur vollständigen Übersicht und zu weiteren Filtern</a>
      </p>

      <h2 class="visually-hidden">Treffer</h2>

      {
        entries.length === 0 ? (
          <div class="notice">
            <p>Für diesen Filter gibt es aktuell noch keine Einträge.</p>
          </div>
        ) : (
          <ul class="anlaufstellen-grid">
            {entries.map((entry) => (
              <li>
                <AnlaufstelleKarte entry={entry} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .facette-intro {
    max-width: var(--measure);
    margin-top: var(--space-sm);
  }

  .facette-intro__hinweis {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin-top: var(--space-2xs);
  }

  .lead {
    max-width: var(--measure);
    margin-bottom: var(--space-lg);
  }

  .anlaufstellen-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-md);
  }
</style>
