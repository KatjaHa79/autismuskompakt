---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import KurzGesagt from "../components/KurzGesagt.astro";
import StandDatum from "../components/StandDatum.astro";
import Quellenblock from "../components/Quellenblock.astro";
import Hinweisbox from "../components/Hinweisbox.astro";
import { categoryLabels, categoryHrefs, categoriesRequiringUpdated, targetGroupLabels } from "../content.config";
import { PASSENDE_MATERIALIEN } from "../lib/artikel-materialien";

interface Props {
  entry: CollectionEntry<"artikel">;
}

const { entry } = Astro.props;
const { title, description, category, targetGroups, updated, sources } = entry.data;

const zeigtRechtlichenHinweis = categoriesRequiringUpdated.has(category);

const materialIds = PASSENDE_MATERIALIEN[entry.id] ?? [];
const alleMaterialien = materialIds.length > 0 ? await getCollection("materialien") : [];
const passendeMaterialien = materialIds
  .map((id) => alleMaterialien.find((material) => material.id === id))
  .filter((material) => material !== undefined);
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: categoryLabels[category], href: categoryHrefs[category] },
        { label: title },
      ]}
    />
  </div>

  <article class="section">
    <div class="container">
      <p class="zielgruppen">
        Für: {targetGroups.map((gruppe) => targetGroupLabels[gruppe]).join(", ")}
      </p>
      <h1>{title}</h1>

      <KurzGesagt text={description} />

      <div class="prose">
        <slot />
      </div>

      {
        passendeMaterialien.length > 0 && (
          <Hinweisbox titel={passendeMaterialien.length > 1 ? "Passende Arbeitsblätter" : "Passendes Arbeitsblatt"}>
            <ul class="passende-materialien">
              {passendeMaterialien.map((material) => (
                <li>
                  <p class="passende-materialien__titel">{material.data.title}</p>
                  <p class="passende-materialien__beschreibung">{material.data.description}</p>
                  <a href={`/materialien/#${material.id}`}>
                    {material.data.title} ansehen <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </Hinweisbox>
        )
      }

      {
        zeigtRechtlichenHinweis && (
          <Hinweisbox titel="Wichtiger Hinweis">
            <p>
              Dieser Beitrag bietet allgemeine Informationen und ersetzt keine
              Rechtsberatung und keine medizinische oder therapeutische
              Beratung im Einzelfall.
            </p>
          </Hinweisbox>
        )
      }

      {updated && <StandDatum date={updated} />}

      <Quellenblock sources={sources} />
    </div>
  </article>
</BaseLayout>

<style>
  .zielgruppen {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: var(--space-md);
  }

  h1 {
    margin-top: var(--space-2xs);
  }

  .prose {
    padding-block: 0;
  }

  .passende-materialien {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .passende-materialien li + li {
    padding-top: var(--space-sm);
    border-top: var(--border-width) solid var(--color-border);
  }

  .passende-materialien__titel {
    font-weight: 700;
  }

  .passende-materialien__beschreibung {
    font-size: 0.95rem;
  }
</style>
