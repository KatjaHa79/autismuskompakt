---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PlannedTopics from "../../components/PlannedTopics.astro";
import ThemenKachel from "../../components/ThemenKachel.astro";

const angehoerigeThemen = [
  { label: "Autismus verstehen", href: "/fuer-autistische-menschen/was-ist-autismus/" },
  { label: "Kommunikation verstehen", href: "/fuer-autistische-menschen/kommunikation/" },
  { label: "Reizverarbeitung", href: "/fuer-autistische-menschen/reizverarbeitung/" },
  { label: "Verhalten einordnen", href: "/angehoerige-fachkraefte/autistisches-kind-begleiten/" },
  { label: "Unterstützung im Alltag", href: "/angehoerige-fachkraefte/unterstuetzung-ohne-bevormundung/" },
  { label: "Diagnose eines Kindes", href: "/angehoerige-fachkraefte/eltern-nach-der-diagnose/" },
  { label: "Schule und Kita", href: "/angehoerige-fachkraefte/schule-und-bildung/" },
  {
    label: "Nachteilsausgleiche",
    href: "/angehoerige-fachkraefte/nachteilsausgleich-und-schulbegleitung/",
  },
  { label: "Hilfen beantragen", href: "/fuer-autistische-menschen/rechte-und-antraege/" },
  {
    label: "Übergang ins Erwachsenenalter",
    href: "/angehoerige-fachkraefte/uebergang-ins-erwachsenenalter/",
  },
  { label: "Beziehungen", href: "/angehoerige-fachkraefte/partnerschaft-und-spaete-diagnose/" },
  {
    label: "Unterstützung ohne Bevormundung",
    href: "/angehoerige-fachkraefte/unterstuetzung-ohne-bevormundung/",
  },
];

const fachkraefteGruppen = [
  {
    titel: "Kommunikation & Begegnung",
    kacheln: [
      {
        icon: "sprechblase",
        title: "Autismusfreundliche Kommunikation",
        description: "Worauf es bei verständlicher, respektvoller Kommunikation mit autistischen Menschen ankommt.",
        href: "/fuer-autistische-menschen/kommunikation/",
      },
      {
        icon: "ebenen",
        title: "Barrieren erkennen",
        description: "Wie unnötige Hürden im Kontakt mit autistischen Menschen entstehen – und wie sie sich abbauen lassen.",
        href: "/fuer-autistische-menschen/reizverarbeitung/",
      },
      {
        icon: "wellen",
        title: "Sensorische Bedürfnisse berücksichtigen",
        description: "Wie Reizverarbeitung den Alltag beeinflusst und worauf Fachkräfte achten können.",
        href: "/fuer-autistische-menschen/reizverarbeitung/",
      },
    ],
  },
  {
    titel: "Medizin, Beratung & Therapie",
    kacheln: [
      {
        icon: "kalender",
        title: "Arzttermine gestalten",
        description: "Praktische Hinweise, damit Arzttermine für autistische Patient:innen gut zugänglich sind.",
        href: "/fuer-autistische-menschen/alltag/arzttermine/",
      },
      {
        icon: "kompass",
        title: "Beratung",
        description: "Anlaufstellen und Angebote mit Beratungsschwerpunkt finden.",
        href: "/hilfe-finden/kategorie/beratung/",
      },
      {
        icon: "regler",
        title: "Therapie",
        description: "Therapeutische Anlaufstellen und Angebote im Überblick.",
        href: "/hilfe-finden/",
      },
    ],
  },
  {
    titel: "Bildung & Arbeitswelt",
    kacheln: [
      {
        icon: "buch",
        title: "Schule",
        description: "Unterstützung, Nachteilsausgleiche und Zusammenarbeit rund um Schule und Bildung.",
        href: "/angehoerige-fachkraefte/schule-und-bildung/",
      },
      {
        icon: "buch",
        title: "Pädagogik",
        description: "Pädagogische Begleitung, die autistische Bedürfnisse ernst nimmt.",
        href: "/angehoerige-fachkraefte/schule-und-bildung/",
      },
      {
        icon: "uhr",
        title: "Arbeitsplatz",
        description: "Wie sich Arbeitsplätze autismusfreundlich gestalten lassen.",
        href: "/fuer-autistische-menschen/alltag/arbeit/",
      },
    ],
  },
  {
    titel: "Materialien",
    kacheln: [
      {
        icon: "buch",
        title: "Materialien für die Praxis",
        description: "Kostenlose Arbeitsblätter und Checklisten für den fachlichen Alltag.",
        href: "/materialien/",
      },
    ],
  },
] as const;
---

<BaseLayout
  title="Für Angehörige & Fachkräfte"
  description="Informationen für Angehörige und Fachkräfte zum Thema Autismus – verständlich, praxisnah und aufeinander abgestimmt."
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Für Angehörige & Fachkräfte" }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1>Für Angehörige & Fachkräfte</h1>
      <p class="lead">
        Ob Familie, Partner:in, Freund:in oder Fachkraft aus Medizin,
        Therapie, Pädagogik oder Beratung: Hier findest du Informationen für
        deine jeweilige Rolle. Grundlagenwissen wird dabei nicht doppelt
        geschrieben, sondern gemeinsam genutzt und um den passenden Kontext
        ergänzt.
      </p>
    </div>
  </section>

  <section id="angehoerige" class="section section--alt">
    <div class="container">
      <h2>Ich bin Angehörige:r</h2>
      <p class="lead-small">Zum Beispiel Eltern, Partner:innen, Familie oder Freund:innen.</p>
      <PlannedTopics topics={angehoerigeThemen} />
    </div>
  </section>

  <section id="fachkraefte" class="section">
    <div class="container">
      <h2>Ich bin Fachkraft</h2>
      <p class="lead-small">
        Zum Beispiel aus Medizin, Therapie, Pädagogik, Schule, Beratung,
        Sozialarbeit oder als Arbeitgeber:in.
      </p>
      {
        fachkraefteGruppen.map((gruppe) => (
          <div class="themen-gruppe">
            <h3>{gruppe.titel}</h3>
            <div class="themen-kacheln">
              {gruppe.kacheln.map((kachel) => (
                <ThemenKachel
                  icon={kachel.icon}
                  title={kachel.title}
                  description={kachel.description}
                  href={kachel.href}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.15rem;
  }

  .lead-small {
    max-width: var(--measure);
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
  }

  .themen-gruppe + .themen-gruppe {
    margin-top: var(--space-lg);
  }

  .themen-gruppe h3 {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: var(--space-sm);
  }

  .themen-kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-sm);
  }
</style>
