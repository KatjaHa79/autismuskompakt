        href: "/hilfe-finden/",
      },
    ],
  },
  {
    titel: "Bildung & Arbeitswelt",
    kacheln: [
      {
        icon: "buch",
        title: "Schule",
        description: "Unterstützung, Nachteilsausgleiche und Zusammenarbeit rund um Schule und Bildung.",
        href: "/angehoerige-fachkraefte/schule-und-bildung/",
      },
      {
        icon: "buch",
