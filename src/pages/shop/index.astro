---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const buecher = [
  { titel: "Autismus kompakt" },
  { titel: "Neuro-Kompass" },
];
---

<BaseLayout
  title="Shop"
  description="Bücher, digitale Produkte und Merchandise rund um Autismuskompakt. Verkauf findet ausschließlich über externe Verkaufsstellen statt."
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Shop" }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1>Shop</h1>
      <p class="lead">
        Auf Autismuskompakt.de findet kein eigener Kaufvorgang statt. Hier
        werden Produkte vorgestellt; der Kauf erfolgt über externe
        Verkaufsstellen, die als solche gekennzeichnet sind.
      </p>
    </div>
  </section>

  <section id="buecher" class="section section--alt">
    <div class="container">
      <h2>Bücher</h2>
      <ul class="card-grid">
        {
          buecher.map((buch) => (
            <li class="book-card">
              <p class="book-card__cover placeholder">Cover folgt</p>
              <h3>{buch.titel}</h3>
              <p class="placeholder">Beschreibung und Zielgruppe folgen</p>
              <a class="button button--secondary" href="TODO_KATJA_SHOP_URL">
                Zum Buch <span class="visually-hidden">{buch.titel}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="digitale-produkte" class="section">
    <div class="container">
      <h2>Digitale Produkte</h2>
      <p class="lead-small">
        Zum Beispiel Workbooks, umfangreichere PDF-Pakete, Planer oder
        Kartensets. Kostenpflichtige digitale Produkte gehören hierher;
        kostenlose Materialien findest du unter
        <a href="/materialien/">Materialien</a>.
      </p>
      <div class="notice">
        <p>Diese Kategorie befindet sich im Aufbau.</p>
      </div>
    </div>
  </section>

  <section id="merchandise" class="section section--alt">
    <div class="container">
      <h2>Kleidung & Merchandise</h2>
      <p class="lead-small">Zum Beispiel T-Shirts, Hoodies, Taschen oder Tassen.</p>
      <div class="notice">
        <p>Diese Kategorie befindet sich im Aufbau.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.15rem;
  }

  .lead-small {
    max-width: var(--measure);
    margin-bottom: var(--space-md);
  }

  h2 {
    margin-bottom: var(--space-sm);
  }

  .book-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
    min-height: auto;
    background-color: var(--color-white);
    border: var(--border-width) solid var(--color-petrol-100);
    border-radius: var(--radius);
    padding: var(--space-md);
  }

  .book-card__cover {
    width: 100%;
    text-align: center;
    padding-block: var(--space-lg);
  }

  .book-card .button {
    margin-top: var(--space-xs);
  }

  .notice {
    margin-top: var(--space-sm);
  }
</style>
