---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProduktKarte from "../../components/ProduktKarte.astro";
import { getCollection } from "astro:content";

const alleProdukte = await getCollection("produkte");
const sortiert = alleProdukte.sort((a, b) => a.data.title.localeCompare(b.data.title, "de"));

const buecher = sortiert.filter((p) => p.data.productType === "buch");
const digitaleProdukte = sortiert.filter((p) => p.data.productType === "digitales-produkt");
const merchandise = sortiert.filter((p) => p.data.productType === "merchandise");
---

<BaseLayout
  title="Shop"
  description="Bücher, digitale Produkte und Merchandise rund um Autismuskompakt. Verkauf findet ausschließlich über externe Verkaufsstellen statt."
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Shop" }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1>Shop</h1>
      <p class="lead">
        Hier findest du Bücher und künftig weitere Materialien rund um
        Autismus, Neurodivergenz und einen Alltag, der zu den eigenen
        Bedürfnissen passt.
      </p>
      <p class="lead-small">
        Auf Autismuskompakt.de findet kein eigener Kaufvorgang statt. Hier
        werden Produkte vorgestellt; der Kauf erfolgt über externe
        Verkaufsstellen, die als solche gekennzeichnet sind. Kostenlose
        Materialien findest du nicht hier, sondern unter
        <a href="/materialien/">Hilfreiches Material</a>.
      </p>
    </div>
  </section>

  <section id="buecher" class="section section--alt">
    <div class="container">
      <h2>Bücher</h2>
      <ul class="card-grid card-grid--buecher">
        {
          buecher.map((buch) => (
            <li>
              <ProduktKarte entry={buch} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="digitale-produkte" class="section">
    <div class="container">
      <h2>Digitale Produkte</h2>
      <p class="lead-small">
        Zum Beispiel Workbooks, umfangreichere PDF-Pakete, Planer oder
        Kartensets. Kostenpflichtige digitale Produkte gehören hierher;
        kostenlose Materialien findest du unter
        <a href="/materialien/">Hilfreiches Material</a>.
      </p>
      {
        digitaleProdukte.length > 0 ? (
          <ul class="card-grid">
            {digitaleProdukte.map((produkt) => (
              <li>
                <ProduktKarte entry={produkt} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="notice">
            <p>Diese Kategorie befindet sich im Aufbau.</p>
          </div>
        )
      }
    </div>
  </section>

  <section id="merchandise" class="section section--alt">
    <div class="container">
      <h2>Merchandise</h2>
      {
        merchandise.length > 0 ? (
          <ul class="card-grid">
            {merchandise.map((produkt) => (
              <li>
                <ProduktKarte entry={produkt} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="notice">
            <p>Hier entsteht gerade etwas Neues.</p>
            <p>
              Ab Anfang Oktober 2026 findest du im Shop auch ausgewählte
              Autismuskompakt-Produkte. Der Bereich wird derzeit
              vorbereitet und nach und nach ergänzt.
            </p>
            <p class="lead-small">Schau gerne wieder vorbei.</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.0625rem; /* ca. 17-18px */
  }

  .lead-small {
    max-width: var(--measure);
    margin-bottom: var(--space-md);
  }

  h2 {
    margin-bottom: var(--space-sm);
  }

  .card-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-md);
  }

  /* Bücher etwas hochwertiger/großzügiger als die übrigen Produktarten. */
  .card-grid--buecher {
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-xl);
  }

  .notice {
    margin-top: var(--space-sm);
  }
</style>
