// Die sechs Themenkarten der AuDHS-Welt (Master-Projektauftrag Punkt 7).
// Die ersten beiden verlinken auf die veröffentlichten Fachartikel; die
// übrigen vier verlinken auf die passenden Abschnitte dieser Übersichts-
// seite selbst, da es dafür noch keine eigenen AuDHS-spezifischen Artikel
// gibt (siehe Punkt 12: keine automatisch erzeugten Platzhalterartikel).
const themenkarten = [
  {
    icon: "regler",
    title: "AuDHS-Symptome erkennen und verstehen",
    description: "Zehn mögliche Merkmale im Alltag – mit Beispielen und praktischen Anregungen.",
    href: "/audhs/symptome/",
  },
  {
    icon: "uhr",
    title: "AuDHS bei Erwachsenen und Diagnostik",
    description: "Warum die Kombination manchmal erst spät erkannt wird und wie die Diagnostik abläuft.",
    href: "/audhs/erwachsene/",
  },
  {
    icon: "kalender",
    title: "AuDHS im Alltag",
    description: "Warum manche gut gemeinten Ratschläge nicht passen – und was stattdessen helfen kann.",
    href: "/audhs/#alltag",
  },
  {
    icon: "wellen",
    title: "Reizverarbeitung und Energie",
    description: "Zwischen Überreizung und Unterforderung: die eigene sensorische Umgebung verstehen.",
    href: "/audhs/#reizverarbeitung-und-energie",
  },
  {
    icon: "sprechblase",
    title: "AuDHS in Beziehungen",
    description: "Unterschiedliche Bedürfnisse nach Nähe, Austausch und Rückzug konkret benennen.",
    href: "/audhs/#beziehungen",
  },
  {
    icon: "ebenen",
    title: "AuDHS im Beruf",
    description: "Welche Arbeitsbedingungen entlasten können – individuell statt nach Schema.",
    href: "/audhs/#beruf",
  },
