---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";

const mehrwert = [
  {
    icon: "stern",
    title: "Neue Inhalte",
    text: "Neue Artikel und wichtige Ergänzungen auf Autismuskompakt – ohne dass du selbst regelmäßig nachsehen musst.",
  },
  {
    icon: "regler",
    title: "Praktische Hilfen",
    text: "Hinweise auf neue Checklisten, Übersichten und Materialien für den Alltag.",
  },
  {
    icon: "kompass",
    title: "Wissen & Orientierung",
    text: "Verständlich aufbereitete Informationen zu Autismus, Diagnostik, Alltag, Arbeit, Rechten und Unterstützungsmöglichkeiten.",
  },
  {
    icon: "sprechblase",
    title: "Ausgewählte Neuigkeiten",
    text: "Nur Informationen mit echtem Mehrwert – keine täglichen E-Mails und keine unnötige Werbung.",
  },
] as const;
---

<BaseLayout
  title="Newsletter"
  description="Verständliche Informationen zu Autismus, Alltag, Diagnostik, Rechten und Unterstützung direkt per E-Mail. Jetzt kostenlos zum Newsletter von Autismuskompakt anmelden."
>
  <div class="container container--wide">
    <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Newsletter" }]} />
  </div>

  <section class="hero">
    <div class="container container--wide">
      <div class="hero__content">
        <h1>Autismus besser verstehen – Wissen, Orientierung und praktische Hilfen direkt in dein Postfach.</h1>
        <p class="hero__lead">
          Bei Autismuskompakt findest du verständliche Informationen rund um Autismus, Alltag,
          Diagnostik, Rechte und Unterstützung. Mit dem Newsletter bekommst du ausgewählte neue
          Inhalte, praktische Hilfen und wichtige Neuigkeiten direkt per E-Mail – übersichtlich,
          verständlich und ohne Informationsflut.
        </p>
        <p class="hero__actions">
          <a class="button button--accent" href="#anmeldung">Kostenlos zum Newsletter anmelden</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="mehrwert-heading">
    <div class="container container--wide">
      <h2 id="mehrwert-heading">Das erwartet dich</h2>
      <div class="mehrwert-grid">
        {
          mehrwert.map((punkt) => (
            <div class="mehrwert-kachel">
              <span class="mehrwert-kachel__icon">
                <Icon name={punkt.icon} size={28} />
              </span>
              <span class="mehrwert-kachel__body">
                <span class="mehrwert-kachel__title">{punkt.title}</span>
                <span class="mehrwert-kachel__text">{punkt.text}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Schön, dass du hier bist.</h2>
      <p>
        Autismuskompakt ist entstanden, weil gute Informationen über Autismus oft über viele
        verschiedene Stellen verteilt, schwer verständlich oder im Alltag nur mühsam zu finden
        sind. Mit dem Newsletter möchte ich dir ausgewählte Informationen direkt schicken –
        verständlich aufbereitet und mit Blick darauf, was im Alltag tatsächlich hilfreich sein
        kann.
      </p>
    </div>
  </section>

  <section id="anmeldung" class="section section--alt" aria-labelledby="anmeldung-heading">
    <div class="container">
      <h2 id="anmeldung-heading">Jetzt anmelden</h2>

      <div class="newsletter-form-card">
        <div id="sib-form-container" class="sib-form-container">
          <div
            id="error-message"
            class="sib-form-message-panel sib-form-message-panel--error"
            role="alert"
            aria-live="assertive"
          >
            <svg viewBox="0 0 512 512" class="sib-icon sib-notification__icon" aria-hidden="true">
              <path d="M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z" />
            </svg>
            <span class="sib-form-message-panel__inner-text">
              Deine Anmeldung konnte leider nicht übermittelt werden. Bitte versuche es noch
              einmal. Sollte es weiterhin nicht funktionieren, versuche es bitte zu einem
              späteren Zeitpunkt erneut.
            </span>
          </div>

          <div
            id="success-message"
            class="sib-form-message-panel sib-form-message-panel--success"
            role="status"
            aria-live="polite"
          >
            <svg viewBox="0 0 512 512" class="sib-icon sib-notification__icon" aria-hidden="true">
              <path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z" />
            </svg>
            <span class="sib-form-message-panel__inner-text">
              Fast geschafft! Wir haben dir eine E-Mail geschickt. Bitte klicke auf den
              Bestätigungslink in dieser E-Mail, um deine Anmeldung zum Newsletter abzuschließen.
              Falls du die E-Mail nicht gleich findest, schau bitte auch in deinem Spam-Ordner
              nach.
            </span>
          </div>

          <div id="sib-container" class="sib-container--large sib-container--vertical">
            <form
              id="sib-form"
              method="POST"
              action="https://8d06c77e.sibforms.com/serve/MUIFALamz7EXR90AoDn-Liem1788vONX3YdCMfh1asTW2grSbmrW4aWXMxl4EAWY52qxMAadK9K16u-WLQVtqFdmP-DbgmweEmI2Pmo02jdIVxptfA1_otAE9oow0rdoqc8-HBmcqHisHfnRG3vtfMabE0r4VUF-eoEfD272UZWZ5NpLkaKRAp9MKqMOpurqgvGMT322O8AnxxMLOw=="
              data-type="subscription"
            >
              <div class="sib-input sib-form-block">
                <div class="form__entry entry_block">
                  <div class="form__label-row">
                    <label class="entry__label" for="EMAIL">
                      Deine E-Mail-Adresse <span aria-hidden="true">*</span>
                    </label>
                    <div class="entry__field">
                      <input
                        class="input"
                        type="email"
                        id="EMAIL"
                        name="EMAIL"
                        autocomplete="email"
                        value=""
                        placeholder="z. B. name@beispiel.de"
                        data-required="true"
                        required
                      />
                    </div>
                  </div>
                  <label class="entry__error entry__error--primary"></label>
                  <label class="entry__specification">
                    An diese Adresse senden wir dir den Bestätigungslink und anschließend den
                    Newsletter.
                  </label>
                </div>
              </div>

              <div class="sib-optin sib-form-block">
                <div class="form__entry entry_mcq">
                  <div class="form__label-row">
                    <div class="entry__choice">
                      <label class="opt-in-label">
                        <input type="checkbox" class="input_replaced" value="1" id="OPT_IN" name="OPT_IN" required />
                        <span class="opt-in-text">
                          Ich möchte den Newsletter von Autismus kompakt per E-Mail erhalten. Ich
                          kann meine Einwilligung jederzeit mit Wirkung für die Zukunft
                          widerrufen, zum Beispiel über den Abmeldelink in jeder E-Mail. Weitere
                          Informationen finde ich in der
                          <a href="/datenschutz/">Datenschutzerklärung</a>.
                        </span>
                      </label>
                    </div>
                  </div>
                  <label class="entry__error entry__error--primary"></label>
                </div>
              </div>

              <p class="required-hint">* Pflichtfeld</p>

              <div class="sib-form__declaration">
                <p>
                  Wir verwenden Brevo für den Versand unseres Newsletters. Mit dem Absenden dieses
                  Formulars werden die von dir angegebenen Daten zur Verarbeitung an Brevo
                  übermittelt. Weitere Informationen findest du in unserer
                  <a href="/datenschutz/">Datenschutzerklärung</a>
                  und in der
                  <a href="https://www.brevo.com/en/legal/privacypolicy/" target="_blank" rel="noopener noreferrer">
                    Datenschutzerklärung von Brevo <span aria-hidden="true">↗</span>
                    <span class="visually-hidden">(öffnet auf einer anderen Website)</span>
                  </a>.
                </p>
              </div>

              <button
                class="sib-form-block__button sib-form-block__button-with-loader button button--accent"
                form="sib-form"
                type="submit"
              >
                <svg class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon" viewBox="0 0 512 512" aria-hidden="true">
                  <path d="M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261.028 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z" />
                </svg>
                Newsletter kostenlos abonnieren
              </button>

              <input
                type="text"
                name="email_address_check"
                value=""
                class="input--hidden"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />
              <input type="hidden" name="locale" value="en" />
            </form>
          </div>
        </div>
      </div>

      <p class="trust-note">
        <strong>Kostenlos · jederzeit abmeldbar · keine tägliche E-Mail-Flut.</strong> Du bekommst
        ausgewählte neue Inhalte und wichtige Informationen – nicht täglich und nicht wegen jeder
        kleinen Änderung. Du kannst deine Einwilligung jederzeit mit Wirkung für die Zukunft
        widerrufen; in jeder Newsletter-E-Mail findest du außerdem einen Abmeldelink. Weitere
        Informationen in der <a href="/datenschutz/">Datenschutzerklärung</a>.
      </p>
    </div>
  </section>

  <script defer is:inline src="https://sibforms.com/forms/end-form/build/main.js"></script>
  <script is:inline>
    window.REQUIRED_CODE_ERROR_MESSAGE = "Bitte wähle eine Ländervorwahl aus.";
    window.LOCALE = "en";
    window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = window.GENERIC_INVALID_MESSAGE =
      "Bitte überprüfe deine Angaben. Achte insbesondere darauf, dass deine E-Mail-Adresse vollständig und korrekt eingegeben ist.";
    window.REQUIRED_ERROR_MESSAGE = "Bitte fülle dieses Pflichtfeld aus.";
    window.INVALID_NUMBER = "Bitte prüfe deine Eingabe.";
    window.INVALID_DATE = "Bitte gib ein gültiges Datum ein.";
    window.REQUIRED_MULTISELECT_MESSAGE = "Bitte wähle mindestens eine Option aus.";
    window.translation = {
      common: {
        selectedList: "{quantity} Liste ausgewählt",
        selectedLists: "{quantity} Listen ausgewählt",
        selectedOption: "{quantity} ausgewählt",
        selectedOptions: "{quantity} ausgewählt",
      },
    };
    var AUTOHIDE = Boolean(1);
  </script>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-lg) var(--space-md);
    border-bottom: var(--border-width) solid var(--color-bronze-soft);
  }

  .hero__content {
    max-width: var(--measure);
  }

  .hero h1 {
    max-width: 22ch;
    line-height: 1.2;
  }

  .hero__lead {
    margin-top: var(--space-sm);
    max-width: 62ch;
    font-size: 1rem;
  }

  .hero__actions {
    margin-top: var(--space-md);
  }

  .mehrwert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-sm);
  }

  .mehrwert-kachel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-width: 0;
    padding: var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
  }

  .mehrwert-kachel__icon {
    display: inline-flex;
    color: var(--color-petrol);
  }

  .mehrwert-kachel__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .mehrwert-kachel__title {
    font-weight: 700;
    color: var(--color-petrol);
    font-size: 1rem;
    line-height: 1.25;
  }

  .mehrwert-kachel__text {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* ==========================================================================
     Formular-Karte: gleiche technische Struktur wie das bestehende
     Brevo-Formular unter /kostenloser-leitfaden/ (Feldnamen/IDs von main.js
     benötigt), hier in eigener Textfassung ohne Leitfaden-Bezug.
     ========================================================================== */

  .newsletter-form-card {
    max-width: 34rem;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }

  /* Sichtbarkeit bleibt vollständig Brevos main.js überlassen: einzige
     display-Deklaration für diese beiden Panels ist "none" als Grundzustand
     (main.js schaltet per Inline-Style auf sichtbar um, sobald der
     jeweilige Zustand eintritt – kein !important, keine zweite
     display-Regel, damit Brevos Entscheidung immer gewinnen kann).

     Die eigentliche Gestaltung (Farbe/Hintergrund/Rahmen/Abstand) hängt
     bewusst an der ID statt an main.js' eigenen Klassen
     ("sib-form-message-panel(--success/--error)"): main.js kann diese
     Klassen beim Umschalten verändern, die ID nicht – so bleibt der Inhalt
     eines sichtbaren Panels auch dann lesbar gestaltet, wenn main.js seine
     eigenen Klassen ohne das (bewusst nicht geladene) externe
     Brevo-Stylesheet setzt. */
  #error-message,
  #success-message {
    display: none;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-sm);
    border-radius: var(--radius);
    border: var(--border-width) solid transparent;
    margin-bottom: var(--space-md);
    font-weight: 700;
  }

  #error-message {
    color: var(--color-error);
    background-color: #fbeceb;
    border-color: var(--color-error);
  }

  #success-message {
    color: var(--color-petrol-dark);
    background-color: var(--color-background-alt);
    border-color: var(--color-petrol);
  }

  #error-message .sib-form-message-panel__inner-text,
  #success-message .sib-form-message-panel__inner-text {
    color: inherit;
  }

  .sib-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  .form__entry {
    margin-bottom: var(--space-md);
  }

  .entry__label {
    display: block;
    font-weight: 700;
    margin-bottom: var(--space-2xs);
  }

  .entry__field .input {
    width: 100%;
    border: var(--border-width) solid var(--color-text-muted);
    background-color: var(--color-background);
    color: var(--color-text);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius);
    min-height: 44px;
  }

  .entry__error {
    display: block;
    color: var(--color-error);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .entry__error:empty {
    display: none;
  }

  .entry__specification {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: var(--space-2xs);
  }

  .entry_mcq .form__label-row {
    display: block;
  }

  .opt-in-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    cursor: pointer;
  }

  .opt-in-label input[type="checkbox"] {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15em;
    accent-color: var(--color-petrol);
  }

  .required-hint {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    margin-bottom: var(--space-md);
  }

  .sib-form__declaration p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-block: var(--space-md);
  }

  .sib-form-block__button {
    width: auto;
  }

  .sib-hide-loader-icon {
    display: none;
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  /* Versteckt (Honeypot gegen Spam-Bots), technisch von Brevo benötigt –
     bewusst außerhalb des sichtbaren Bereichs statt display:none, damit die
     Feldlogik unverändert funktioniert; für Tastatur/Screenreader über
     tabindex="-1"/aria-hidden zusätzlich aus der Bedienreihenfolge genommen. */
  .input--hidden {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .trust-note {
    max-width: 34rem;
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 30rem) {
    .sib-form-block__button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
