---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemenKachel from "../../../components/ThemenKachel.astro";

const reizeUndEnergie = [
  { icon: "wellen", label: "Reizüberflutung", href: "/fuer-autistische-menschen/alltag/reizmanagement-im-alltag/" },
  { icon: "wellen", label: "Reize reduzieren", href: "/fuer-autistische-menschen/alltag/reizmanagement-im-alltag/" },
  { icon: "mond", label: "Rückzug", href: "/fuer-autistische-menschen/alltag/reizmanagement-im-alltag/" },
  { icon: "regler", label: "Energie einteilen", href: "/fuer-autistische-menschen/alltag/reizmanagement-im-alltag/" },
  { icon: "mond", label: "Erholung", href: "/fuer-autistische-menschen/alltag/reisen-und-freizeit/" },
  { icon: "kompass", label: "Reisen & Freizeit", href: "/fuer-autistische-menschen/alltag/reisen-und-freizeit/" },
  { icon: "wellen", label: "Overload im Alltag", href: "/fuer-autistische-menschen/overload/" },
  { icon: "wellen", label: "Meltdown im Alltag", href: "/fuer-autistische-menschen/meltdown/" },
  { icon: "mond", label: "Shutdown im Alltag", href: "/fuer-autistische-menschen/shutdown/" },
  { icon: "mond", label: "Autistischer Burnout im Alltag", href: "/fuer-autistische-menschen/autistischer-burnout/" },
] as const;

const kommunikation = [
  { icon: "sprechblase", label: "Bedürfnisse mitteilen", href: "/fuer-autistische-menschen/alltag/kommunikation-im-alltag/" },
  { icon: "sprechblase", label: "Grenzen setzen", href: "/fuer-autistische-menschen/alltag/kommunikation-im-alltag/" },
  { icon: "sprechblase", label: "Telefonieren", href: "/fuer-autistische-menschen/alltag/kommunikation-im-alltag/" },
  {
    icon: "sprechblase",
    label: "Schriftliche Kommunikation",
    href: "/fuer-autistische-menschen/alltag/kommunikation-im-alltag/",
  },
  { icon: "kreise", label: "Missverständnisse", href: "/fuer-autistische-menschen/double-empathy/" },
  { icon: "sprechblase", label: "Small Talk", href: "/fuer-autistische-menschen/alltag/kommunikation-im-alltag/" },
] as const;

const kommunikationGeplant = ["Kommunikationshilfen"];

const alltagsorganisation = [
  { icon: "kalender", label: "Tagesstruktur", href: "/fuer-autistische-menschen/alltag/tagesstruktur-und-uebergaenge/" },
  { icon: "kalender", label: "Veränderungen", href: "/fuer-autistische-menschen/alltag/tagesstruktur-und-uebergaenge/" },
  { icon: "kalender", label: "Übergänge", href: "/fuer-autistische-menschen/alltag/tagesstruktur-und-uebergaenge/" },
  { icon: "regler", label: "Einkaufen", href: "/fuer-autistische-menschen/alltag/einkaufen-haushalt-und-essen/" },
  { icon: "regler", label: "Haushalt", href: "/fuer-autistische-menschen/alltag/einkaufen-haushalt-und-essen/" },
  { icon: "regler", label: "Essen", href: "/fuer-autistische-menschen/alltag/einkaufen-haushalt-und-essen/" },
  { icon: "mond", label: "Schlaf", href: "/fuer-autistische-menschen/alltag/schlaf-im-alltag/" },
  { icon: "kalender", label: "Arzttermine", href: "/fuer-autistische-menschen/alltag/arzttermine/" },
  { icon: "buch", label: "Behördenkontakte", href: "/fuer-autistische-menschen/alltag/behoerdenkontakte/" },
] as const;

const beziehungen = [
  { icon: "kreise", label: "Partnerschaft", href: "/fuer-autistische-menschen/alltag/partnerschaft-und-freundschaften/" },
  { icon: "kreise", label: "Freundschaften", href: "/fuer-autistische-menschen/alltag/partnerschaft-und-freundschaften/" },
  { icon: "kreise", label: "Familie", href: "/fuer-autistische-menschen/alltag/familie-und-konflikte/" },
  { icon: "wellen", label: "Konflikte", href: "/fuer-autistische-menschen/alltag/familie-und-konflikte/" },
  { icon: "mond", label: "Nähe & Rückzug", href: "/fuer-autistische-menschen/alltag/naehe-rueckzug-und-alleinzeit/" },
  {
    icon: "sprechblase",
    label: "Grenzen & Zustimmung",
    href: "/fuer-autistische-menschen/alltag/sexualitaet-grenzen-und-zustimmung/",
  },
] as const;

const beziehungenGeplant = ["Dating"];

const arbeitAusbildungStudium = [
  { icon: "uhr", label: "Arbeitsplatz gestalten", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  { icon: "wellen", label: "Reize am Arbeitsplatz", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  { icon: "sprechblase", label: "Kommunikation mit Vorgesetzten", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  { icon: "sprechblase", label: "Offenlegung der Diagnose", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  { icon: "kalender", label: "Homeoffice", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  {
    icon: "ebenen",
    label: "Nachteilsausgleich",
    href: "/fuer-autistische-menschen/alltag/ausbildung-und-studium/",
  },
  { icon: "buch", label: "Studium", href: "/fuer-autistische-menschen/alltag/ausbildung-und-studium/" },
  { icon: "buch", label: "Ausbildung", href: "/fuer-autistische-menschen/alltag/ausbildung-und-studium/" },
  { icon: "uhr", label: "Bewerbung", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  { icon: "uhr", label: "Jobwechsel", href: "/fuer-autistische-menschen/alltag/arbeit/" },
] as const;

const wohnenUndSelbststaendigkeit = [
  { icon: "kompass", label: "Allein wohnen", href: "/fuer-autistische-menschen/alltag/wohnen-und-assistenz/" },
  { icon: "kreise", label: "Assistenz", href: "/fuer-autistische-menschen/alltag/wohnen-und-assistenz/" },
  { icon: "regler", label: "Unterstützungsbedarf", href: "/fuer-autistische-menschen/alltag/wohnen-und-assistenz/" },
  { icon: "kompass", label: "Wohnformen", href: "/fuer-autistische-menschen/alltag/wohnen-und-assistenz/" },
] as const;

const gesundheitUndTherapie = [
  {
    icon: "wellen",
    label: "Schmerzen & körperliche Symptome",
    href: "/fuer-autistische-menschen/alltag/schmerzen-und-koerperliche-symptome/",
  },
  {
    icon: "kalender",
    label: "Krankenhaus, Notaufnahme & Zahnarzt",
    href: "/fuer-autistische-menschen/alltag/krankenhaus-notaufnahme-und-zahnarzt/",
  },
  {
    icon: "regler",
    label: "Psychotherapie & Medikamente",
    href: "/fuer-autistische-menschen/alltag/psychotherapie-und-medikamente/",
  },
  {
    icon: "regler",
    label: "Ergotherapie, Logopädie & AAC",
    href: "/fuer-autistische-menschen/alltag/ergotherapie-logopaedie-und-aac/",
  },
  {
    icon: "auge",
    label: "Therapieangebote kritisch prüfen",
    href: "/fuer-autistische-menschen/alltag/therapieangebote-kritisch-pruefen/",
  },
] as const;
---

<BaseLayout
  title="Alltag & Leben"
  description="Konkrete, alltagstaugliche Unterstützung für autistische Menschen: Reizmanagement, Tagesstruktur, Arbeit, Wohnen und mehr."
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Für Autist:innen", href: "/fuer-autistische-menschen/" },
        { label: "Alltag & Leben" },
      ]}
    />
  </div>

  <section class="section">
    <div class="container">
      <h1>Alltag & Leben</h1>
      <p class="lead">
        Dieser Bereich soll praktische, alltagstaugliche Unterstützung
        bieten – von Reizmanagement über Behördenkontakte bis zu Arbeit und
        Wohnen.
      </p>

      <h2>Reize & Energie</h2>
      <div class="themen-kacheln">
        {reizeUndEnergie.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <h2>Kommunikation</h2>
      <div class="themen-kacheln">
        {kommunikation.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>
      <p class="geplant-hinweis">In Vorbereitung: {kommunikationGeplant.join(" · ")}.</p>

      <h2>Alltagsorganisation</h2>
      <div class="themen-kacheln">
        {alltagsorganisation.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <h2>Beziehungen</h2>
      <div class="themen-kacheln">
        {beziehungen.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>
      <p class="geplant-hinweis">In Vorbereitung: {beziehungenGeplant.join(" · ")}.</p>

      <h2>Arbeit, Ausbildung & Studium</h2>
      <div class="themen-kacheln">
        {arbeitAusbildungStudium.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <h2>Wohnen & Selbstständigkeit</h2>
      <div class="themen-kacheln">
        {wohnenUndSelbststaendigkeit.map((thema) => (
          <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />
        ))}
      </div>

      <h2>Gesundheit & Therapie</h2>
      <div class="themen-kacheln">
        {gesundheitUndTherapie.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <div class="notice">
        <p>
          Diese Seite befindet sich im Aufbau. Ausführliche Beiträge
          entstehen in den nächsten Etappen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.0625rem; /* ca. 17-18px */
    margin-bottom: var(--space-lg);
  }

  h2 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  h2:first-of-type {
    margin-top: 0;
  }

  .notice {
    margin-top: var(--space-lg);
  }

  .themen-kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-sm);
  }

  .geplant-hinweis {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.9375rem; /* ca. 14-15px */
  }
</style>
