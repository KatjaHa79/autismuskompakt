---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PlannedTopics from "../../../components/PlannedTopics.astro";

const reizeUndEnergie = [
  { label: "Reizüberflutung", href: "/fuer-autistische-menschen/alltag/reizmanagement-im-alltag/" },
  "Reize reduzieren",
  "Rückzug",
  "Energie einteilen",
  "Erholung",
  { label: "Overload im Alltag", href: "/fuer-autistische-menschen/overload/" },
  { label: "Meltdown im Alltag", href: "/fuer-autistische-menschen/meltdown/" },
  { label: "Shutdown im Alltag", href: "/fuer-autistische-menschen/shutdown/" },
  { label: "Autistischer Burnout im Alltag", href: "/fuer-autistische-menschen/autistischer-burnout/" },
];

const kommunikation = [
  "Bedürfnisse mitteilen",
  "Grenzen setzen",
  "Telefonieren",
  "Schriftliche Kommunikation",
  "Missverständnisse",
  "Small Talk",
  "Kommunikationshilfen",
];

const alltagsorganisation = [
  "Tagesstruktur",
  "Veränderungen",
  "Termine",
  "Einkaufen",
  "Haushalt",
  "Essen",
  "Schlaf",
  { label: "Arzttermine", href: "/fuer-autistische-menschen/alltag/arzttermine/" },
  "Behördenkontakte",
];

const beziehungen = ["Partnerschaft", "Freundschaften", "Familie", "Konflikte", "Nähe & Rückzug", "Dating", "Grenzen & Zustimmung"];

const arbeitAusbildungStudium = [
  { label: "Arbeitsplatz gestalten", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  "Reize am Arbeitsplatz",
  "Kommunikation mit Vorgesetzten",
  "Offenlegung der Diagnose",
  "Homeoffice",
  "Nachteilsausgleich",
  "Studium",
  "Ausbildung",
  "Bewerbung",
  "Jobwechsel",
];

const wohnenUndSelbststaendigkeit = ["Allein wohnen", "Assistenz", "Unterstützungsbedarf", "Wohnformen"];
---

<BaseLayout
  title="Alltag & Leben"
  description="Konkrete, alltagstaugliche Unterstützung für autistische Menschen: Reizmanagement, Tagesstruktur, Arbeit, Wohnen und mehr."
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Für Autist:innen", href: "/fuer-autistische-menschen/" },
        { label: "Alltag & Leben" },
      ]}
    />
  </div>

  <section class="section">
    <div class="container">
      <h1>Alltag & Leben</h1>
      <p class="lead">
        Dieser Bereich soll praktische, alltagstaugliche Unterstützung
        bieten – von Reizmanagement über Behördenkontakte bis zu Arbeit und
        Wohnen.
      </p>

      <h2>Reize & Energie</h2>
      <PlannedTopics topics={reizeUndEnergie} />

      <h2>Kommunikation</h2>
      <PlannedTopics topics={kommunikation} />

      <h2>Alltagsorganisation</h2>
      <PlannedTopics topics={alltagsorganisation} />

      <h2>Beziehungen</h2>
      <PlannedTopics topics={beziehungen} />

      <h2>Arbeit, Ausbildung & Studium</h2>
      <PlannedTopics topics={arbeitAusbildungStudium} />

      <h2>Wohnen & Selbstständigkeit</h2>
      <PlannedTopics topics={wohnenUndSelbststaendigkeit} />

      <div class="notice">
        <p>
          Diese Seite befindet sich im Aufbau. Ausführliche Beiträge
          entstehen in den nächsten Etappen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.15rem;
    margin-bottom: var(--space-lg);
  }

  h2 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  h2:first-of-type {
    margin-top: 0;
  }

  .notice {
    margin-top: var(--space-lg);
  }
</style>
