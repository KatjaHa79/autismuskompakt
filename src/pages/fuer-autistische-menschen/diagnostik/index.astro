---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemenKachel from "../../../components/ThemenKachel.astro";

const themen = [
  { icon: "kompass", label: "Könnte ich autistisch sein?", href: "/fuer-autistische-menschen/diagnostik/koennte-ich-autistisch-sein/" },
  {
    icon: "kompass",
    label: "Wann ist eine Diagnostik sinnvoll?",
    href: "/fuer-autistische-menschen/diagnostik/koennte-ich-autistisch-sein/",
  },
  {
    icon: "uhr",
    label: "Wie läuft eine Autismusdiagnostik ab?",
    href: "/fuer-autistische-menschen/diagnostik/ablauf-der-diagnostik/",
  },
  {
    icon: "uhr",
    label: "Diagnostik bei Erwachsenen",
    href: "/fuer-autistische-menschen/diagnostik/diagnostik-bei-erwachsenen/",
  },
  { icon: "auge", label: "Diagnostik bei Frauen", href: "/fuer-autistische-menschen/diagnostik/diagnostik-bei-frauen/" },
  {
    icon: "regler",
    label: "Vorbereitung auf die Diagnostik",
    href: "/fuer-autistische-menschen/diagnostik/vorbereitung-auf-die-diagnostik/",
  },
  {
    icon: "buch",
    label: "Hilfreiche Unterlagen",
    href: "/fuer-autistische-menschen/diagnostik/vorbereitung-auf-die-diagnostik/",
  },
  { icon: "kreise", label: "Diagnostikstellen finden", href: "/hilfe-finden/kategorie/diagnostik/" },
  { icon: "sprechblase", label: "Was bedeutet das Ergebnis?", href: "/fuer-autistische-menschen/diagnostik/ergebnis-der-diagnostik/" },
  {
    icon: "stern",
    label: "Was passiert nach der Diagnose?",
    href: "/fuer-autistische-menschen/diagnostik/nach-der-diagnose/",
  },
  { icon: "ebenen", label: "Differenzialdiagnostik", href: "/fuer-autistische-menschen/diagnostik/differenzialdiagnostik/" },
  { icon: "ebenen", label: "ADHS oder Autismus?", href: "/fuer-autistische-menschen/diagnostik/differenzialdiagnostik/" },
  {
    icon: "wellen",
    label: "Autismus und ADHS gleichzeitig",
    href: "/fuer-autistische-menschen/besonderheiten/autismus-und-adhs/",
  },
  {
    icon: "mond",
    label: "Fehldiagnosen und späte Diagnose",
    href: "/fuer-autistische-menschen/diagnostik/diagnostik-bei-erwachsenen/",
  },
  {
    icon: "buch",
    label: "Diagnostik ohne Kindheitsunterlagen",
    href: "/fuer-autistische-menschen/diagnostik/diagnostik-bei-erwachsenen/",
  },
] as const;

const screeningtests = [
  {
    icon: "regler",
    label: "AQ, RAADS-R & CAT-Q: Was sagen sie wirklich?",
    href: "/fuer-autistische-menschen/diagnostik/screeningtests/",
  },
] as const;
---

<BaseLayout
  title="Diagnostik & Tests"
  description="Informationen rund um die Autismus-Diagnostik: Ablauf, Vorbereitung, Screening- und Selbsttests, Diagnostikstellen."
>
  <div class="container container--wide">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Für Autist:innen", href: "/fuer-autistische-menschen/" },
        { label: "Diagnostik & Tests" },
      ]}
    />
  </div>

  <section class="section">
    <div class="container container--wide">
      <h1>Diagnostik & Tests</h1>
      <p class="lead">
        Dieser Bereich wird Informationen rund um die Autismus-Diagnostik
        sammeln – von ersten Anzeichen über den Ablauf einer Diagnostik bis
        zur Suche nach einer Diagnostikstelle.
      </p>

      <div class="orientierungscheck-einstieg">
        <h2>Autismuskompakt-Orientierungscheck</h2>
        <p>
          Ein wertschätzender, interaktiver Orientierungscheck für Erwachsene:
          eigene Erfahrungen mit sozialer Kommunikation, Reizen, Routinen,
          Masking und Überlastung besser einordnen. Läuft vollständig lokal in
          deinem Browser – kein diagnostischer Test.
        </p>
        <p>
          <a class="button button--primary" href="/fuer-autistische-menschen/diagnostik/orientierungscheck/">
            Orientierungscheck starten
          </a>
        </p>
      </div>

      <h2>Geplante Themen</h2>
      <div class="themen-kacheln">
        {themen.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <h3>Screeningtests</h3>
      <div class="themen-kacheln">
        {screeningtests.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <div class="notice">
        <p>
          Wichtiger Hinweis für später: Ein Screeningtest kann Hinweise
          geben, ersetzt aber keine fachliche Diagnostik.
        </p>
        <p>
          Diese Seite befindet sich im Aufbau. Ausführliche Beiträge
          entstehen in den nächsten Etappen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 60rem;
    font-size: 1rem; /* ca. 15.5-16px */
    margin-bottom: var(--space-lg);
  }

  h2 {
    margin-bottom: var(--space-sm);
  }

  h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .notice {
    margin-top: var(--space-lg);
  }

  .notice p + p {
    margin-top: var(--space-xs);
  }

  .orientierungscheck-einstieg {
    max-width: var(--measure);
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-left: 4px solid var(--color-petrol);
    border-radius: var(--radius);
  }

  .orientierungscheck-einstieg h2 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .orientierungscheck-einstieg p {
    margin-bottom: var(--space-sm);
  }

  .orientierungscheck-einstieg p:last-child {
    margin-bottom: 0;
  }

  .themen-kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-sm);
  }
</style>
