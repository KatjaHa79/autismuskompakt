---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PlannedTopics from "../../../components/PlannedTopics.astro";

const themen = [
  { label: "Könnte ich autistisch sein?", href: "/fuer-autistische-menschen/diagnostik/koennte-ich-autistisch-sein/" },
  "Wann ist eine Diagnostik sinnvoll?",
  {
    label: "Wie läuft eine Autismusdiagnostik ab?",
    href: "/fuer-autistische-menschen/diagnostik/ablauf-der-diagnostik/",
  },
  {
    label: "Diagnostik bei Erwachsenen",
    href: "/fuer-autistische-menschen/diagnostik/diagnostik-bei-erwachsenen/",
  },
  "Diagnostik bei Frauen",
  "Vorbereitung auf die Diagnostik",
  "Hilfreiche Unterlagen",
  "Diagnostikstellen finden",
  "Was bedeutet das Ergebnis?",
  "Was passiert nach der Diagnose?",
  "Differenzialdiagnostik",
  "ADHS oder Autismus?",
  {
    label: "Autismus und ADHS gleichzeitig",
    href: "/fuer-autistische-menschen/besonderheiten/autismus-und-adhs/",
  },
  "Fehldiagnosen und späte Diagnose",
  "Diagnostik ohne Kindheitsunterlagen",
];

const screeningtests = ["AQ", "RAADS-R", "CAT-Q"];
---

<BaseLayout
  title="Diagnostik & Tests"
  description="Informationen rund um die Autismus-Diagnostik: Ablauf, Vorbereitung, Screening- und Selbsttests, Diagnostikstellen."
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Für Autist:innen", href: "/fuer-autistische-menschen/" },
        { label: "Diagnostik & Tests" },
      ]}
    />
  </div>

  <section class="section">
    <div class="container">
      <h1>Diagnostik & Tests</h1>
      <p class="lead">
        Dieser Bereich wird Informationen rund um die Autismus-Diagnostik
        sammeln – von ersten Anzeichen über den Ablauf einer Diagnostik bis
        zur Suche nach einer Diagnostikstelle.
      </p>

      <h2>Geplante Themen</h2>
      <PlannedTopics topics={themen} />

      <h3>Screeningtests</h3>
      <PlannedTopics topics={screeningtests} />

      <div class="notice">
        <p>
          Wichtiger Hinweis für später: Ein Screeningtest kann Hinweise
          geben, ersetzt aber keine fachliche Diagnostik.
        </p>
        <p>
          Diese Seite befindet sich im Aufbau. Ausführliche Beiträge
          entstehen in den nächsten Etappen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.15rem;
    margin-bottom: var(--space-lg);
  }

  h2 {
    margin-bottom: var(--space-sm);
  }

  h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .notice {
    margin-top: var(--space-lg);
  }

  .notice p + p {
    margin-top: var(--space-xs);
  }
</style>
