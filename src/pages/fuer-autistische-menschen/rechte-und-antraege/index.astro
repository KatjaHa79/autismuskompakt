---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PlannedTopics from "../../../components/PlannedTopics.astro";

const kernbereiche = [
  { label: "GdB", href: "/fuer-autistische-menschen/rechte-und-antraege/gdb/" },
  "Schwerbehindertenausweis",
  "Merkzeichen",
  { label: "Pflegegrad", href: "/fuer-autistische-menschen/rechte-und-antraege/pflegegrad/" },
  {
    label: "Persönliches Budget",
    href: "/fuer-autistische-menschen/rechte-und-antraege/persoenliches-budget/",
  },
  "Eingliederungshilfe",
  "Assistenzleistungen",
  "Nachteilsausgleich",
  "Hilfsmittel",
  "Leistungen zur Teilhabe am Arbeitsleben",
];

const weitereThemen = [
  "Rehabilitation",
  "Erwerbsminderungsrente",
  "Unterstützung in der Schule",
  "Unterstützung im Studium",
  "Unterstützung am Arbeitsplatz",
  "Steuerliche Nachteilsausgleiche",
  "Mobilität",
  "Widerspruch gegen einen Bescheid",
];
---

<BaseLayout
  title="Rechte & Anträge"
  description="Überblick über Sozialleistungen und Anträge, die für autistische Menschen relevant sein können: GdB, Pflegegrad, Eingliederungshilfe und mehr."
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Für Autist:innen", href: "/fuer-autistische-menschen/" },
        { label: "Rechte & Anträge" },
      ]}
    />
  </div>

  <section class="section">
    <div class="container">
      <h1>Rechte & Anträge</h1>
      <p class="lead">
        Grundfrage dieses Bereichs: Was kann ich wo beantragen? Hier
        entstehen nach und nach verständliche Übersichten zu den
        wichtigsten Sozialleistungen und Nachteilsausgleichen.
      </p>

      <h2>Kernbereiche</h2>
      <PlannedTopics topics={kernbereiche} />

      <h3>Weitere Themen</h3>
      <PlannedTopics topics={weitereThemen} />

      <div class="notice">
        <p>
          Jede einzelne Leistungsseite folgt künftig einem einheitlichen
          Aufbau: kurz gesagt, worum es geht, für wen die Leistung infrage
          kommt, wo sie beantragt wird, Voraussetzungen, benötigte
          Unterlagen, Ablauf, was nach dem Antrag passiert, was bei
          Ablehnung zu tun ist, passende Downloads, Hilfe/Anlaufstellen,
          offizielle Quellen und ein Stand-Datum.
        </p>
        <p>
          Diese Seite befindet sich im Aufbau. Ausführliche, sozialrechtlich
          geprüfte Beiträge entstehen in den nächsten Etappen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.15rem;
    margin-bottom: var(--space-lg);
  }

  h2 {
    margin-bottom: var(--space-sm);
  }

  h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .notice {
    margin-top: var(--space-lg);
  }

  .notice p + p {
    margin-top: var(--space-xs);
  }
</style>
