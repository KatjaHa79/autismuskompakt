---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemenKachel from "../../../components/ThemenKachel.astro";

const kernbereiche = [
  { icon: "buch", label: "GdB", href: "/fuer-autistische-menschen/rechte-und-antraege/gdb/" },
  { icon: "buch", label: "Schwerbehindertenausweis", href: "/fuer-autistische-menschen/rechte-und-antraege/gdb/" },
  { icon: "buch", label: "Merkzeichen", href: "/fuer-autistische-menschen/rechte-und-antraege/gdb/" },
  { icon: "regler", label: "Pflegegrad", href: "/fuer-autistische-menschen/rechte-und-antraege/pflegegrad/" },
  {
    icon: "buch",
    label: "Persönliches Budget",
    href: "/fuer-autistische-menschen/rechte-und-antraege/persoenliches-budget/",
  },
  {
    icon: "kreise",
    label: "Eingliederungshilfe",
    href: "/fuer-autistische-menschen/rechte-und-antraege/eingliederungshilfe-und-assistenz/",
  },
  {
    icon: "kreise",
    label: "Assistenzleistungen",
    href: "/fuer-autistische-menschen/rechte-und-antraege/eingliederungshilfe-und-assistenz/",
  },
  {
    icon: "ebenen",
    label: "Nachteilsausgleich",
    href: "/fuer-autistische-menschen/rechte-und-antraege/steuerliche-nachteilsausgleiche/",
  },
  {
    icon: "regler",
    label: "Hilfsmittel",
    href: "/fuer-autistische-menschen/rechte-und-antraege/eingliederungshilfe-und-assistenz/",
  },
  {
    icon: "uhr",
    label: "Leistungen zur Teilhabe am Arbeitsleben",
    href: "/fuer-autistische-menschen/rechte-und-antraege/erwerbsminderungsrente/",
  },
] as const;

const weitereThemen = [
  { icon: "uhr", label: "Rehabilitation", href: "/fuer-autistische-menschen/rechte-und-antraege/erwerbsminderungsrente/" },
  {
    icon: "buch",
    label: "Erwerbsminderungsrente",
    href: "/fuer-autistische-menschen/rechte-und-antraege/erwerbsminderungsrente/",
  },
  { icon: "uhr", label: "Unterstützung im Studium", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  { icon: "uhr", label: "Unterstützung am Arbeitsplatz", href: "/fuer-autistische-menschen/alltag/arbeit/" },
  {
    icon: "ebenen",
    label: "Steuerliche Nachteilsausgleiche",
    href: "/fuer-autistische-menschen/rechte-und-antraege/steuerliche-nachteilsausgleiche/",
  },
  {
    icon: "buch",
    label: "Widerspruch gegen einen Bescheid",
    href: "/fuer-autistische-menschen/rechte-und-antraege/widerspruch-klage-und-akteneinsicht/",
  },
] as const;

const weitereThemenGeplant = ["Unterstützung in der Schule", "Mobilität"];
---

<BaseLayout
  title="Rechte & Anträge"
  description="Überblick über Sozialleistungen und Anträge, die für autistische Menschen relevant sein können: GdB, Pflegegrad, Eingliederungshilfe und mehr."
>
  <div class="container container--wide">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Für Autist:innen", href: "/fuer-autistische-menschen/" },
        { label: "Rechte & Anträge" },
      ]}
    />
  </div>

  <section class="section">
    <div class="container container--wide">
      <h1>Rechte & Anträge</h1>
      <p class="lead">
        Grundfrage dieses Bereichs: Was kann ich wo beantragen? Hier
        entstehen nach und nach verständliche Übersichten zu den
        wichtigsten Sozialleistungen und Nachteilsausgleichen.
      </p>

      <h2>Kernbereiche</h2>
      <div class="themen-kacheln">
        {kernbereiche.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <h3>Weitere Themen</h3>
      <div class="themen-kacheln">
        {weitereThemen.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>
      <p class="geplant-hinweis">
        In Vorbereitung: {weitereThemenGeplant.join(" · ")}.
      </p>

      <div class="notice">
        <p>
          Jede einzelne Leistungsseite folgt künftig einem einheitlichen
          Aufbau: kurz gesagt, worum es geht, für wen die Leistung infrage
          kommt, wo sie beantragt wird, Voraussetzungen, benötigte
          Unterlagen, Ablauf, was nach dem Antrag passiert, was bei
          Ablehnung zu tun ist, passende Downloads, Hilfe/Anlaufstellen,
          offizielle Quellen und ein Stand-Datum.
        </p>
        <p>
          Diese Seite befindet sich im Aufbau. Ausführliche, sozialrechtlich
          geprüfte Beiträge entstehen in den nächsten Etappen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 60rem;
    font-size: 1rem; /* ca. 15.5-16px */
    margin-bottom: var(--space-lg);
  }

  h2 {
    margin-bottom: var(--space-sm);
  }

  h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .notice {
    margin-top: var(--space-lg);
  }

  .notice p + p {
    margin-top: var(--space-xs);
  }

  .themen-kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-sm);
  }

  .geplant-hinweis {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.9375rem; /* ca. 14-15px */
  }
</style>
