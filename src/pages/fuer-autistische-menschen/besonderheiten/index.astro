---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemenKachel from "../../../components/ThemenKachel.astro";

const neurodivergent = [
  {
    icon: "ebenen",
    label: "ADHS",
    href: "/fuer-autistische-menschen/besonderheiten/autismus-und-adhs/",
  },
  {
    icon: "wellen",
    label: "Autismus + ADHS",
    href: "/fuer-autistische-menschen/besonderheiten/autismus-und-adhs/",
  },
  {
    icon: "regler",
    label: "Dyspraxie",
    href: "/fuer-autistische-menschen/besonderheiten/motorische-besonderheiten-und-dyspraxie/",
  },
  {
    icon: "wellen",
    label: "Sensorische Besonderheiten",
    href: "/fuer-autistische-menschen/reizverarbeitung/",
  },
  {
    icon: "kalender",
    label: "ARFID / selektives Essen",
    href: "/fuer-autistische-menschen/besonderheiten/selektives-essen-und-arfid/",
  },
  {
    icon: "sprechblase",
    label: "Sprache und Kommunikation",
    href: "/fuer-autistische-menschen/besonderheiten/sprache-und-kommunikation/",
  },
  {
    icon: "ebenen",
    label: "Intellektuelle Entwicklungsstörung",
    href: "/fuer-autistische-menschen/besonderheiten/intellektuelle-entwicklungsstoerung/",
  },
] as const;

const neurodivergentGeplant = ["Alexithymie", "Exekutive Dysfunktion", "Interozeption"];

const psychischeBelastungen = [
  { icon: "wellen", label: "Angst", href: "/fuer-autistische-menschen/besonderheiten/angststoerungen/" },
  { icon: "mond", label: "Depression", href: "/fuer-autistische-menschen/besonderheiten/depression/" },
  { icon: "regler", label: "Zwangssymptome", href: "/fuer-autistische-menschen/besonderheiten/zwangsstoerung/" },
  { icon: "mond", label: "Traumafolgen", href: "/fuer-autistische-menschen/besonderheiten/traumafolgen-und-ptbs/" },
  { icon: "mond", label: "Autistischer Burnout", href: "/fuer-autistische-menschen/autistischer-burnout/" },
  {
    icon: "wellen",
    label: "Selbstverletzendes Verhalten",
    href: "/fuer-autistische-menschen/besonderheiten/selbstverletzendes-verhalten/",
  },
  { icon: "stern", label: "Suizidalität (Krisenhilfe)", href: "/fuer-autistische-menschen/besonderheiten/suizidalitaet/" },
] as const;

const koerperlicheBegleiterkrankungen = [
  { icon: "mond", label: "Schlafstörungen", href: "/fuer-autistische-menschen/besonderheiten/schlafstoerungen/" },
  { icon: "wellen", label: "Epilepsie", href: "/fuer-autistische-menschen/besonderheiten/epilepsie/" },
  { icon: "wellen", label: "Migräne", href: "/fuer-autistische-menschen/besonderheiten/migraene-und-kopfschmerzen/" },
  {
    icon: "kalender",
    label: "Gastrointestinale Beschwerden",
    href: "/fuer-autistische-menschen/besonderheiten/gastrointestinale-beschwerden/",
  },
] as const;
---

<BaseLayout
  title="Besonderheiten & Begleiterkrankungen"
  description="Wissenschaftlich fundierte Informationen zu Besonderheiten und Begleiterkrankungen bei Autismus sowie zu Belastungszuständen wie Meltdown und Burnout."
>
  <div class="container container--wide">
    <Breadcrumbs
      items={[
        { label: "Start", href: "/" },
        { label: "Für Autist:innen", href: "/fuer-autistische-menschen/" },
        { label: "Besonderheiten & Begleiterkrankungen" },
      ]}
    />
  </div>

  <section class="section">
    <div class="container container--wide">
      <h1>Besonderheiten & Begleiterkrankungen</h1>
      <p class="lead">
        Autismus tritt häufig gemeinsam mit weiteren Besonderheiten oder
        Begleiterkrankungen auf. Dieser Bereich wird dazu wissenschaftlich
        fundierte und neurodiversitätsorientierte Informationen sammeln.
      </p>

      <h2>Neurodivergente und kognitive Besonderheiten</h2>
      <div class="themen-kacheln">
        {neurodivergent.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>
      <p class="geplant-hinweis">
        In Vorbereitung: {neurodivergentGeplant.join(" · ")}.
      </p>

      <h2>Psychische Belastungen</h2>
      <div class="themen-kacheln">
        {psychischeBelastungen.map((thema) => <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />)}
      </div>

      <h2>Körperliche Begleiterkrankungen</h2>
      <div class="themen-kacheln">
        {koerperlicheBegleiterkrankungen.map((thema) => (
          <ThemenKachel icon={thema.icon} title={thema.label} href={thema.href} />
        ))}
      </div>

      <div class="notice">
        <p>
          Diese Seite befindet sich im Aufbau. Beiträge werden nur auf
          Grundlage nachvollziehbarer Quellen erstellt und unterscheiden
          klar zwischen gesicherten Zusammenhängen und bloßen
          Assoziationen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 60rem;
    font-size: 1rem; /* ca. 15.5-16px */
    margin-bottom: var(--space-lg);
  }

  h2 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  h2:first-of-type {
    margin-top: 0;
  }

  .notice {
    margin-top: var(--space-lg);
  }

  .themen-kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-sm);
  }

  .geplant-hinweis {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.9375rem; /* ca. 14-15px */
  }
</style>
