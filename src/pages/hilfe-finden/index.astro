---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AnlaufstelleKarte from "../../components/AnlaufstelleKarte.astro";
import {
  ageGroupLabels,
  bundeslandLabels,
  targetGroupLabels,
} from "../../content.config";
import {
  getAlleAnlaufstellen,
  getBundeslaenderMitEintraegen,
  getZielgruppenMitEintraegen,
  getAltersgruppenMitEintraegen,
} from "../../lib/anlaufstellen";

const alle = await getAlleAnlaufstellen();
const bundeslaender = await getBundeslaenderMitEintraegen();
const zielgruppen = await getZielgruppenMitEintraegen();
const altersgruppen = await getAltersgruppenMitEintraegen();

// Passende Downloads je Situation (Master-Projektauftrag, Abschnitt P).
// Ergänzt die Anlaufstellen-Datenbank um konkrete Arbeitsblätter, ersetzt
// die bestehenden Filter unten aber nicht.
const alleMaterialien = await getCollection("materialien");
const nachId = new Map(alleMaterialien.map((entry) => [entry.id, entry]));
const passendeDownloadsProSituation: Array<{ situation: string; ids: string[] }> = [
  { situation: "Ich vermute, dass ich autistisch bin.", ids: ["01-autismusverdacht-was-jetzt"] },
  { situation: "Ich möchte mich auf eine Diagnostik vorbereiten.", ids: ["02-vorbereitung-autismusdiagnostik"] },
  {
    situation: "Mein Alltag ist gerade überfordernd.",
    ids: [
      "03-belastungs-energie-check",
      "12-was-hilft-mir-was-belastet-mich",
      "17-wochenplan-mit-erholungszeiten",
      "34-alltag-funktioniert-nicht-mehr-was-jetzt",
    ],
  },
  { situation: "Ich bereite einen Arzttermin vor.", ids: ["04-arzttermin-vorbereitung"] },
  {
    situation: "Ich möchte einen Antrag stellen oder Rechte klären.",
    ids: [
      "07-gdb-antrag-vorbereitung",
      "08-pflegegrad-begutachtung-vorbereitung",
      "09-widerspruch-bescheid-check",
      "22-antrag-vorbereiten-unterlagen-fristen",
    ],
  },
  { situation: "Ich habe gerade meine Diagnose bekommen.", ids: ["33-nach-der-autismusdiagnose-was-jetzt"] },
  { situation: "Ich weiß nicht, welche Unterstützung ich brauche.", ids: ["35-welche-unterstuetzung-brauche-ich"] },
  { situation: "Ich möchte eine passende Anlaufstelle auswählen.", ids: ["36-anlaufstellen-check"] },
  { situation: "Ich möchte meine nächsten Schritte koordinieren.", ids: ["37-mein-persoenlicher-hilfeplan"] },
];
const passendeDownloads = passendeDownloadsProSituation.map((eintrag) => ({
  situation: eintrag.situation,
  materialien: eintrag.ids.map((id) => nachId.get(id)).filter((m) => m !== undefined),
}));
---

<BaseLayout
  title="Hilfe finden"
  description="Anlaufstellen zum Thema Autismus: Diagnostik, Beratung, Therapie, Sozialrecht und Selbsthilfe. Filterbar nach Bundesland, Kategorie und Zielgruppe."
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Hilfe finden" }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1>Hilfe finden</h1>
      <p class="lead">
        Eine gepflegte Übersicht über Anlaufstellen zum Thema Autismus – zum
        Beispiel für Diagnostik, Beratung, Therapie, Sozialrecht oder
        Selbsthilfe. Diese Übersicht wächst mit jedem weiteren Ausbauschritt.
      </p>

      <div class="notice">
        <p>
          Es werden ausschließlich geprüfte Anlaufstellen mit Angabe von
          Quelle und Stand-Datum aufgenommen – erfundene oder ungeprüfte
          Einträge finden hier keinen Platz.
        </p>
        <p>
          Die Angaben wurden sorgfältig anhand öffentlich zugänglicher
          Quellen recherchiert (Stand: 27.08.2026). Angebote,
          Zuständigkeiten, Aufnahmestatus und Wartezeiten können sich
          kurzfristig ändern. Bitte erkundige dich deshalb direkt bei der
          jeweiligen Einrichtung nach dem aktuellen Stand. Die Aufnahme in
          dieses Verzeichnis stellt keine Empfehlung oder Qualitätsbewertung
          dar. Autismuskompakt.de steht mit den aufgeführten Stellen nicht
          automatisch in Kooperation und erhält für die Aufnahme in das
          Verzeichnis keine Vergütung, sofern nicht ausdrücklich anders
          gekennzeichnet.
        </p>
      </div>

      <div class="notice">
        <p>
          <strong>Akute Hilfe:</strong> Bei unmittelbarer Lebensgefahr wähle
          <strong>112</strong> oder gehe in die nächste Notaufnahme. Die
          TelefonSeelsorge ist kostenlos und rund um die Uhr erreichbar unter
          <strong>0800 1110111</strong>, <strong>0800 1110222</strong> oder
          <strong>116 123</strong> – auch per Chat und Mail über{" "}
          <a href="https://www.telefonseelsorge.de/">telefonseelsorge.de</a>.
          Die 116117 ist für dringende, nicht lebensbedrohliche Beschwerden
          außerhalb regulärer Sprechzeiten gedacht.
        </p>
      </div>

      <div class="orientierung">
        <h2>Du musst nicht wissen, wie dein Problem fachlich heißt</h2>
        <p class="lead-small">
          Du startest bei deiner aktuellen Situation – nicht bei einem
          Fachbegriff. Wähle unten den Satz, der am besten passt.
        </p>
        <ul class="orientierung-liste">
          <li>
            <a href="/fuer-autistische-menschen/diagnostik/koennte-ich-autistisch-sein/">
              Ich vermute, dass ich autistisch bin.
            </a>
          </li>
          <li>
            <a href="/fuer-autistische-menschen/diagnostik/nach-der-diagnose/">
              Ich habe gerade meine Diagnose bekommen.
            </a>
          </li>
          <li>
            <a href="/fuer-autistische-menschen/alltag/reizmanagement-im-alltag/">
              Ich komme im Alltag nicht mehr zurecht.
            </a>
          </li>
          <li>
            <a href="/fuer-autistische-menschen/rechte-und-antraege/">Ich brauche Hilfe mit Behörden oder Anträgen.</a>
          </li>
          <li>
            <a href="/hilfe-finden/kategorie/diagnostik/">Ich suche eine Diagnostikstelle.</a>
          </li>
          <li>
            <a href="/hilfe-finden/kategorie/beratung/">Ich suche Unterstützung oder Beratung.</a>
          </li>
        </ul>
      </div>

      <div class="orientierung">
        <h2>Passende Arbeitsblätter für deine Situation</h2>
        <p class="lead-small">
          Zusätzlich zu den Anlaufstellen unten gibt es kostenlose
          Arbeitsblätter und Checklisten für einzelne Situationen. Alle
          Downloads findest du gesammelt auf der <a href="/materialien/">Materialien-Seite</a>.
        </p>
        <ul class="downloads-liste">
          {
            passendeDownloads.map(
              (eintrag) =>
                eintrag.materialien.length > 0 && (
                  <li>
                    <p class="downloads-liste__situation">{eintrag.situation}</p>
                    <ul class="downloads-liste__links">
                      {eintrag.materialien.map((material) => (
                        <li>
                          <a href={`/materialien/#${material.id}`}>{material.data.title}</a>
                        </li>
                      ))}
                    </ul>
                  </li>
                )
            )
          }
        </ul>
      </div>

      <div class="filter-panel">
        <h2>Nach Kriterien filtern</h2>
        <div class="filter-groups">
          <div class="filter-group">
            <h3>Bundesland</h3>
            <ul class="filter-list">
              {
                [...bundeslaender].map((land) => (
                  <li>
                    <a href={`/hilfe-finden/bundesland/${land}/`}>{bundeslandLabels[land]}</a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="filter-group">
            <h3>Zielgruppe</h3>
            <ul class="filter-list">
              {
                [...zielgruppen].map((gruppe) => (
                  <li>
                    <a href={`/hilfe-finden/zielgruppe/${gruppe}/`}>{targetGroupLabels[gruppe]}</a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="filter-group">
            <h3>Altersgruppe</h3>
            <ul class="filter-list">
              {
                [...altersgruppen].map((gruppe) => (
                  <li>
                    <a href={`/hilfe-finden/altersgruppe/${gruppe}/`}>{ageGroupLabels[gruppe]}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="alle-heading">
    <div class="container">
      <h2 id="alle-heading">Alle Anlaufstellen</h2>
      <ul class="anlaufstellen-grid">
        {
          alle.map((entry) => (
            <li>
              <AnlaufstelleKarte entry={entry} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.15rem;
    margin-bottom: var(--space-md);
  }

  .notice {
    margin-top: var(--space-md);
  }

  .orientierung {
    margin-top: var(--space-lg);
  }

  .lead-small {
    max-width: var(--measure);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .orientierung-liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .orientierung-liste a {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-surface);
    border-radius: var(--radius);
    border: var(--border-width) solid var(--color-background-alt);
  }

  .anlaufstellen-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-md);
  }

  .downloads-liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .downloads-liste > li + li {
    padding-top: var(--space-sm);
    border-top: var(--border-width) solid var(--color-border);
  }

  .downloads-liste__situation {
    font-weight: 700;
    margin-bottom: var(--space-2xs);
  }

  .downloads-liste__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .downloads-liste__links a {
    display: inline-block;
    padding: 0.15em 0.7em;
    background-color: var(--color-background-alt);
    border-radius: 999px;
  }
</style>
