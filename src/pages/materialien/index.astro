---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MaterialKarte from "../../components/MaterialKarte.astro";
import { materialTypeLabels, targetGroupLabels } from "../../content.config";
import { BREVO_LEITFADEN_URL } from "../../lib/constants";
import {
  getAlleMaterialien,
  getZielgruppenMitMaterialien,
  getMaterialtypenMitMaterialien,
} from "../../lib/materialien";

const alle = await getAlleMaterialien();
const zielgruppen = await getZielgruppenMitMaterialien();
const materialtypen = await getMaterialtypenMitMaterialien();
---

<BaseLayout
  title="Materialien"
  description="Kostenlose Checklisten, Vorlagen und Arbeitsblätter zum Thema Autismus – für autistische Menschen, Angehörige und Fachkräfte."
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Materialien" }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1>Materialien</h1>
      <p class="lead">
        Alle hier aufgeführten Materialien sind <strong>kostenlos</strong> und
        ohne Anmeldung nutzbar – zum Beispiel Checklisten, Vorlagen,
        Arbeitsblätter und Gesprächshilfen. Kostenpflichtige digitale Produkte
        findest du im <a href="/shop/#digitale-produkte">Shop</a>.
      </p>
    </div>
  </section>

  <section id="leitfaden" class="section section--alt">
    <div class="container">
      <h2>Kostenloser Leitfaden</h2>
      <p class="lead-small">
        Zusätzlich zu den einzelnen Materialien gibt es ein umfangreicheres
        kostenloses Gesamtpaket.
      </p>
      <p>
        <a class="button button--accent" href={BREVO_LEITFADEN_URL}>Kostenlosen Leitfaden erhalten</a>
        <span class="placeholder-note">(Link folgt) <span aria-hidden="true">↗</span></span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-panel">
        <h2>Nach Kriterien filtern</h2>
        <div class="filter-groups">
          <div class="filter-group">
            <h3>Zielgruppe</h3>
            <ul class="filter-list">
              {
                [...zielgruppen].map((gruppe) => (
                  <li>
                    <a href={`/materialien/zielgruppe/${gruppe}/`}>{targetGroupLabels[gruppe]}</a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="filter-group">
            <h3>Materialtyp</h3>
            <ul class="filter-list">
              {
                [...materialtypen].map((typ) => (
                  <li>
                    <a href={`/materialien/typ/${typ}/`}>{materialTypeLabels[typ]}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="alle-heading">
    <div class="container">
      <h2 id="alle-heading">Alle Materialien</h2>
      <p class="lead-small">
        Die unten gezeigten Materialien sind derzeit ausschließlich
        Beispieldatensätze zur Vorführung der Struktur.
      </p>
      <ul class="material-grid">
        {
          alle.map((entry) => (
            <li>
              <MaterialKarte entry={entry} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: var(--measure);
    font-size: 1.15rem;
  }

  .lead-small {
    max-width: var(--measure);
    margin-bottom: var(--space-sm);
  }

  h2 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  h2:first-of-type {
    margin-top: 0;
  }

  /* In diesem Abschnitt ist der Filterbereich das einzige Element – die
     obere Linie/Abstand des geteilten .filter-panel wäre hier doppelt,
     da der umgebende Abschnitt bereits eigenen Abstand mitbringt. */
  .filter-panel {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .placeholder-note {
    margin-left: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .material-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-md);
  }
</style>
