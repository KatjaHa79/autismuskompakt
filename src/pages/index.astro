---
import BaseLayout from "../layouts/BaseLayout.astro";

const themen = [
  {
    label: "Autismus verstehen",
    href: "/fuer-autistische-menschen/",
    description: "Grundlagen, Wahrnehmung, Kommunikation und individuelle Ausprägungen.",
  },
  {
    label: "Diagnostik & Tests",
    href: "/fuer-autistische-menschen/diagnostik/",
    description: "Orientierung zur Diagnostik und zu Screeningverfahren.",
  },
  {
    label: "Hilfe & Anlaufstellen",
    href: "/hilfe-finden/",
    description: "Beratungsstellen, Therapie und Selbsthilfeangebote finden.",
  },
  {
    label: "Rechte & Anträge",
    href: "/fuer-autistische-menschen/rechte-und-antraege/",
    description: "Ansprüche, Anträge und rechtliche Grundlagen im Überblick.",
  },
  {
    label: "Alltag & Leben",
    href: "/fuer-autistische-menschen/alltag/",
    description: "Struktur, Reizverarbeitung und Unterstützung im Alltag.",
  },
  {
    label: "Besonderheiten & Begleiterkrankungen",
    href: "/fuer-autistische-menschen/besonderheiten/",
    description: "Häufige Begleiterkrankungen und besondere Ausprägungen.",
  },
  {
    label: "Downloads & Materialien",
    href: "/materialien/",
    description: "Checklisten, Vorlagen und Arbeitsblätter zum Herunterladen.",
  },
];

const zielgruppen = [
  {
    label: "Ich bin autistisch – oder vermute es",
    href: "/fuer-autistische-menschen/",
    description: "Orientierung, Wissen und praktische Hilfen für deinen Alltag.",
  },
  {
    label: "Ich bin Angehörige:r",
    href: "/angehoerige-fachkraefte/#angehoerige",
    description: "Verstehen, begleiten und passende Unterstützung finden.",
  },
  {
    label: "Ich bin Fachkraft",
    href: "/angehoerige-fachkraefte/#fachkraefte",
    description: "Fachlich fundierte Informationen und Materialien für die Praxis.",
  },
];
---

<BaseLayout
  title="Startseite"
  description="Autismuskompakt: verständliche Informationen und konkrete Hilfe zum Thema Autismus für autistische Menschen, Angehörige und Fachkräfte."
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <h1>Autismus verstehen. Unterstützung finden. Den eigenen Weg gehen.</h1>
        <p class="hero__lead">
          Autismuskompakt ist eine reizarme Informations- und Hilfeplattform zum
          Thema Autismus – für autistische Menschen, Angehörige und
          Fachkräfte.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="/fuer-autistische-menschen/">Themen entdecken</a>
          <a class="button button--secondary" href="/hilfe-finden/">Hilfe finden</a>
        </div>
      </div>

      <div class="hero__accent" aria-hidden="true"></div>
    </div>
  </section>

  <section class="section" aria-labelledby="themen-heading">
    <div class="container">
      <h2 id="themen-heading">Themen im Überblick</h2>
      <ol class="theme-list">
        {
          themen.map((thema, index) => (
            <li class="theme-list__item">
              <a class="theme-list__link" href={thema.href}>
                <span class="theme-list__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="theme-list__body">
                  <span class="theme-list__title">{thema.label}</span>
                  <span class="theme-list__desc">{thema.description}</span>
                </span>
                <span class="theme-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="zielgruppen-heading">
    <div class="container">
      <h2 id="zielgruppen-heading">Für wen suchst du Informationen?</h2>
      <div class="audience-grid">
        {
          zielgruppen.map((gruppe) => (
            <a class="audience-item" href={gruppe.href}>
              <span class="audience-item__title">{gruppe.label}</span>
              <span class="audience-item__desc">{gruppe.description}</span>
              <span class="audience-item__arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-md);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .hero__content {
    max-width: 40rem;
  }

  .hero h1 {
    max-width: none;
    line-height: 1.35;
    font-size: clamp(2.125rem, 1.6rem + 1.8vw, 2.875rem);
  }

  .hero__lead {
    margin-top: var(--space-sm);
    max-width: 46ch;
    font-size: 1.25rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* Bewusster Freiraum rechts statt einer Symbolgrafik – nur eine sehr
     feine Bronze-Linie als dezenter typografischer Akzent. */
  .hero__accent {
    display: none;
  }

  /* Ab hier zweispaltig: Text links (~55%), Freiraum rechts (~45%). */
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 11fr 9fr;
      gap: var(--space-2xl);
    }

    .hero__content {
      max-width: none;
    }

    .hero__accent {
      display: block;
      justify-self: start;
      width: 1px;
      height: 100%;
      min-height: 12rem;
      background-color: var(--color-bronze-soft);
    }
  }

  /* Zielgruppenbereich: drei ruhige, typografische Spalten statt Karten. */
  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .audience-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-petrol);
    text-decoration: none;
    color: inherit;
  }

  .audience-item__title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-petrol);
  }

  .audience-item__desc {
    color: var(--color-text-muted);
  }

  .audience-item__arrow {
    margin-top: var(--space-2xs);
    color: var(--color-bronze-dark);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .audience-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
