---
import fs from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemenKachel from "../components/ThemenKachel.astro";
import { ETSY_SHOP_URL } from "../lib/constants";

// Produktfotos aus dem Etsy-Shop "AutismusStyle" – echte Fotos, die Katja
// unter public/images/shop/etsy/ ablegt (shop-produkt-01.webp bis -04.webp).
// Noch nicht vorhandene Dateien werden nicht als defektes <img> ausgegeben,
// sondern zeigen bis dahin einen ruhigen Platzhalter (siehe shopProdukte
// unten) – die Sektion funktioniert dadurch bereits mit nur 3 von 4 Fotos.
const shopProduktDateien = [
  "shop-produkt-01.webp",
  "shop-produkt-02.webp",
  "shop-produkt-03.webp",
  "shop-produkt-04.webp",
];
const shopProdukte = shopProduktDateien.map((datei) => ({
  src: `/images/shop/etsy/${datei}`,
  vorhanden: fs.existsSync(new URL(`../../public/images/shop/etsy/${datei}`, import.meta.url)),
}));

const themen = [
  {
    icon: "kompass",
    label: "Autismus verstehen",
    href: "/fuer-autistische-menschen/",
    description: "Grundlagen zu Autismus, Wahrnehmung, Kommunikation und unterschiedlichen autistischen Erfahrungen.",
  },
  {
    icon: "auge",
    label: "Diagnostik & Tests",
    href: "/fuer-autistische-menschen/diagnostik/",
    description: "Informationen zur Autismusdiagnostik, zum Ablauf einer Abklärung und zu Screeningverfahren.",
  },
  {
    icon: "kreise",
    label: "Hilfe & Anlaufstellen",
    href: "/hilfe-finden/",
    description: "Beratungsstellen, Diagnostikangebote und weitere Unterstützungsmöglichkeiten finden.",
  },
  {
    icon: "buch",
    label: "Rechte & Anträge",
    href: "/fuer-autistische-menschen/rechte-und-antraege/",
    description: "Orientierung zu Nachteilsausgleichen, GdB, Pflegegrad, Teilhabe und weiteren Leistungen.",
  },
  {
    icon: "kalender",
    label: "Alltag & Leben",
    href: "/fuer-autistische-menschen/alltag/",
    description: "Praktische Informationen zu Reizregulation, Kommunikation, Beziehungen, Wohnen, Arbeit und Selbstfürsorge.",
  },
  {
    icon: "ebenen",
    label: "Besonderheiten & Begleiterkrankungen",
    href: "/fuer-autistische-menschen/besonderheiten/",
    description: "Informationen zu häufig gemeinsam auftretenden Besonderheiten, Beschwerden und Diagnosen.",
  },
  {
    icon: "regler",
    label: "Downloads & Materialien",
    href: "/materialien/",
    description: "Kostenlose Checklisten, Vorlagen, Übersichten und Arbeitshilfen zum Herunterladen.",
  },
] as const;

const zielgruppen = [
  {
    icon: "kompass",
    label: "Ich bin autistisch – oder vermute es",
    href: "/fuer-autistische-menschen/",
    description: "Wissen, Orientierung und praktische Hilfen für Diagnostik, Alltag, Selbstverständnis, Rechte und Unterstützung.",
  },
  {
    icon: "kreise",
    label: "Ich bin Angehörige:r",
    href: "/angehoerige-fachkraefte/#angehoerige",
    description: "Autismus besser verstehen, Bedürfnisse einordnen und passende Möglichkeiten zur Unterstützung finden.",
  },
  {
    icon: "buch",
    label: "Ich bin Fachkraft",
    href: "/angehoerige-fachkraefte/#fachkraefte",
    description: "Fundierte Informationen, praktische Materialien und Orientierung für Beratung, Bildung, Arbeit und Begleitung.",
  },
] as const;
---

<BaseLayout
  title="Wissen, Orientierung und praktische Hilfe"
  description="Verständliche Informationen rund um Autismus: Diagnostik, Alltag, Rechte, Anlaufstellen, Begleiterkrankungen, kostenlose Materialien und praktische Hilfen."
>
  <section class="hero">
    <div class="container container--wide">
      <div class="hero__grid">
        <div class="hero__content">
          <h1>Autismus verstehen. Unterstützung finden. Den eigenen Weg gehen.</h1>
          <p class="hero__lead">
            Autismuskompakt bietet verständliche und fundierte Informationen rund
            um Autismus – für autistische Menschen, Angehörige und Fachkräfte.
            Hier findest du Orientierung, praktische Hilfen, Anlaufstellen und
            Materialien für unterschiedliche Lebenssituationen.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="/fuer-autistische-menschen/">Themen entdecken</a>
            <a class="button button--secondary" href="/hilfe-finden/">Anlaufstellen finden</a>
            <a class="button button--accent" href="/newsletter/">Newsletter</a>
          </div>
        </div>
        <div class="hero__media">
          <img
            src="/images/hero/autismuskompakt-hero-stillleben.webp"
            alt=""
            width="1536"
            height="1024"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="themen-heading">
    <div class="container container--wide">
      <h2 id="themen-heading">Themen im Überblick</h2>
      <div class="themen-kacheln">
        {
          themen.map((thema) => (
            <ThemenKachel
              icon={thema.icon}
              title={thema.label}
              description={thema.description}
              href={thema.href}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="zielgruppen-heading">
    <div class="container container--wide">
      <h2 id="zielgruppen-heading">Für wen suchst du Informationen?</h2>
      <div class="themen-kacheln">
        {
          zielgruppen.map((gruppe) => (
            <ThemenKachel
              icon={gruppe.icon}
              title={gruppe.label}
              description={gruppe.description}
              href={gruppe.href}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section newsletter-teaser" aria-labelledby="newsletter-teaser-heading">
    <div class="container">
      <h2 id="newsletter-teaser-heading">Neues von Autismuskompakt direkt ins Postfach</h2>
      <p>
        Ausgewählte neue Inhalte, praktische Hilfen und wichtige Neuigkeiten – übersichtlich,
        verständlich und ohne Informationsflut.
      </p>
      <p>
        <a class="button button--secondary" href="/newsletter/">Kostenlos zum Newsletter anmelden</a>
      </p>
    </div>
  </section>

  <section class="section section--alt shop-teaser" aria-labelledby="shop-teaser-heading">
    <div class="container container--wide">
      <div class="shop-teaser__intro">
        <p class="shop-teaser__eyebrow">Autismus kompakt Shop</p>
        <h2 id="shop-teaser-heading">Autismus sichtbar machen. Auf deine Art.</h2>
        <p>
          Im AutismusStyle-Shop findest du ausgewählte Designs rund um Autismus,
          Neurodivergenz, Kommunikation und Alltag – von klaren Statements bis zu
          praktischen Kommunikationshilfen.
        </p>
        <p class="shop-teaser__actions">
          <a class="button button--accent" href={ETSY_SHOP_URL} target="_blank" rel="noopener noreferrer">
            Zum Etsy-Shop <span aria-hidden="true">↗</span>
            <span class="visually-hidden">(öffnet auf einer anderen Website)</span>
          </a>
        </p>
        <p class="shop-teaser__hint">Produkte von AUTISMUS kompakt · erhältlich über Etsy</p>
      </div>

      <ul class="shop-teaser__gallery">
        {
          shopProdukte.map((produkt) =>
            produkt.vorhanden ? (
              <li>
                <img
                  src={produkt.src}
                  alt="Produkt aus dem AutismusStyle-Shop auf Etsy"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="600"
                />
              </li>
            ) : (
              <li class="shop-teaser__gallery-placeholder placeholder" aria-hidden="true">
                Foto folgt
              </li>
            )
          )
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-lg) var(--space-md);
    border-bottom: var(--border-width) solid var(--color-bronze-soft);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero__content {
    max-width: none;
  }

  .hero h1 {
    max-width: 28ch;
    line-height: 1.2;
  }

  .hero__lead {
    margin-top: var(--space-sm);
    max-width: 62ch;
    font-size: 1rem; /* ca. 15,5-16px */
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  /* Hero-Bild: ruhiges Stillleben statt abstrakter Fläche. Auf
     schmalen Bildschirmen volle Breite im festen Seitenverhältnis
     unterhalb der Buttons; ab der Zweispalten-Schwelle streckt es
     sich auf die Höhe des Textbereichs und füllt die rechte Spalte. */
  .hero__media {
    border-radius: var(--radius);
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .hero__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center 60%;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-xl);
    }

    .hero__media {
      align-self: stretch;
      height: 100%;
      min-height: 18rem;
    }

    .hero__media img {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  .themen-kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-sm);
  }

  .newsletter-teaser p {
    max-width: var(--measure);
  }

  .newsletter-teaser p:last-child {
    margin-top: var(--space-sm);
  }

  .shop-teaser__intro {
    max-width: var(--measure);
  }

  .shop-teaser__eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-bronze-dark);
    margin-bottom: var(--space-2xs);
  }

  .shop-teaser__actions {
    margin-top: var(--space-md);
  }

  .shop-teaser__hint {
    margin-top: var(--space-xs);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .shop-teaser__gallery {
    list-style: none;
    padding: 0;
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .shop-teaser__gallery img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: var(--border-width) solid var(--color-border);
  }

  .shop-teaser__gallery-placeholder {
    aspect-ratio: 1 / 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .shop-teaser__gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
