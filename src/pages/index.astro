---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemenKachel from "../components/ThemenKachel.astro";

const themen = [
  {
    icon: "kompass",
    label: "Autismus verstehen",
    href: "/fuer-autistische-menschen/",
    description: "Grundlagen zu Autismus, Wahrnehmung, Kommunikation und unterschiedlichen autistischen Erfahrungen.",
  },
  {
    icon: "auge",
    label: "Diagnostik & Tests",
    href: "/fuer-autistische-menschen/diagnostik/",
    description: "Informationen zur Autismusdiagnostik, zum Ablauf einer Abklärung und zu Screeningverfahren.",
  },
  {
    icon: "kreise",
    label: "Hilfe & Anlaufstellen",
    href: "/hilfe-finden/",
    description: "Beratungsstellen, Diagnostikangebote und weitere Unterstützungsmöglichkeiten finden.",
  },
  {
    icon: "buch",
    label: "Rechte & Anträge",
    href: "/fuer-autistische-menschen/rechte-und-antraege/",
    description: "Orientierung zu Nachteilsausgleichen, GdB, Pflegegrad, Teilhabe und weiteren Leistungen.",
  },
  {
    icon: "kalender",
    label: "Alltag & Leben",
    href: "/fuer-autistische-menschen/alltag/",
    description: "Praktische Informationen zu Reizregulation, Kommunikation, Beziehungen, Wohnen, Arbeit und Selbstfürsorge.",
  },
  {
    icon: "ebenen",
    label: "Besonderheiten & Begleiterkrankungen",
    href: "/fuer-autistische-menschen/besonderheiten/",
    description: "Informationen zu häufig gemeinsam auftretenden Besonderheiten, Beschwerden und Diagnosen.",
  },
  {
    icon: "regler",
    label: "Downloads & Materialien",
    href: "/materialien/",
    description: "Kostenlose Checklisten, Vorlagen, Übersichten und Arbeitshilfen zum Herunterladen.",
  },
] as const;

const zielgruppen = [
  {
    icon: "kompass",
    label: "Ich bin autistisch – oder vermute es",
    href: "/fuer-autistische-menschen/",
    description: "Wissen, Orientierung und praktische Hilfen für Diagnostik, Alltag, Selbstverständnis, Rechte und Unterstützung.",
  },
  {
    icon: "kreise",
    label: "Ich bin Angehörige:r",
    href: "/angehoerige-fachkraefte/#angehoerige",
    description: "Autismus besser verstehen, Bedürfnisse einordnen und passende Möglichkeiten zur Unterstützung finden.",
  },
  {
    icon: "buch",
    label: "Ich bin Fachkraft",
    href: "/angehoerige-fachkraefte/#fachkraefte",
    description: "Fundierte Informationen, praktische Materialien und Orientierung für Beratung, Bildung, Arbeit und Begleitung.",
  },
] as const;
---

<BaseLayout
  title="Wissen, Orientierung und praktische Hilfe"
  description="Verständliche Informationen rund um Autismus: Diagnostik, Alltag, Rechte, Anlaufstellen, Begleiterkrankungen, kostenlose Materialien und praktische Hilfen."
>
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1>Autismus verstehen. Unterstützung finden. Den eigenen Weg gehen.</h1>
        <p class="hero__lead">
          Autismuskompakt bietet verständliche und fundierte Informationen rund
          um Autismus – für autistische Menschen, Angehörige und Fachkräfte.
          Hier findest du Orientierung, praktische Hilfen, Anlaufstellen und
          Materialien für unterschiedliche Lebenssituationen.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="/fuer-autistische-menschen/">Themen entdecken</a>
          <a class="button button--secondary" href="/hilfe-finden/">Anlaufstellen finden</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="themen-heading">
    <div class="container">
      <h2 id="themen-heading">Themen im Überblick</h2>
      <div class="themen-kacheln">
        {
          themen.map((thema) => (
            <ThemenKachel
              icon={thema.icon}
              title={thema.label}
              description={thema.description}
              href={thema.href}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="zielgruppen-heading">
    <div class="container">
      <h2 id="zielgruppen-heading">Für wen suchst du Informationen?</h2>
      <div class="themen-kacheln">
        {
          zielgruppen.map((gruppe) => (
            <ThemenKachel
              icon={gruppe.icon}
              title={gruppe.label}
              description={gruppe.description}
              href={gruppe.href}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-lg) var(--space-md);
    border-bottom: var(--border-width) solid var(--color-bronze-soft);
  }

  .hero__content {
    max-width: 56rem;
  }

  .hero h1 {
    max-width: 22ch;
    line-height: 1.2;
  }

  .hero__lead {
    margin-top: var(--space-sm);
    max-width: 60ch;
    font-size: 1.0625rem; /* ca. 17px */
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .themen-kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-sm);
  }
</style>
